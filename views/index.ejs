<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Home - ShopHub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="home-page">
  
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>
<%- include("partials/user-navbar") %>
  
  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-text">
      <p class="small-text">Built for your best fit</p>
      <h1>Elevate your shopping experience today!</h1>
      <p class="hero-desc">
        Discover timeless fashion crafted for comfort and confidence.
      </p>
      <a href="/api/users/products" class="hero-btn">Explore Now</a>
    </div>

    <div class="hero-image placeholder-box">
    
    </div>
  </section>

  <!-- New Collection -->
  <section class="collection-banner">
    <h2>New Collection</h2>
    <p>Latest arrivals for every occasion</p>
  </section>

  <!-- Products -->
  <section class="products-section">
    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Classic Jacket</h4>
      <p>$89.00</p>
    </div>

    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Casual Shirt</h4>
      <p>$49.00</p>
    </div>

    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Urban Fit</h4>
      <p>$69.00</p>
    </div>

    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Summer Tee</h4>
      <p>$39.00</p>
    </div>

    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Denim Wear</h4>
      <p>$79.00</p>
    </div>

    <div class="product-card">
      <div class="product-image placeholder-box"></div>
      <h4>Street Style</h4>
      <p>$59.00</p>
    </div>
  </section>

  <!-- Brands -->
  <section class="brands-section">
    <h3>Top Brands</h3>
    <div class="brands-row">
      <span>ADIDAS</span>
      <span>LV</span>
      <span>NIKE</span>
      <span>GUCCI</span>
    </div>
  </section>

  <!-- Deal Section -->
  <section class="deal-section">
    <div class="deal-image placeholder-box"></div>

    <div class="deal-content">
      <h3>Exclusive Deal of The Day</h3>
      <p>Grab your favorites before the timer ends.</p>

      <div class="timer-box">
        <div><strong>05</strong><span>Days</span></div>
        <div><strong>15</strong><span>Hours</span></div>
        <div><strong>40</strong><span>Min</span></div>
      </div>

      <a href="#" class="hero-btn">Shop Now</a>
    </div>
  </section>
  <script src="/js/auth.js"></script>

</body>
</html>