<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Home - ShopHub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="home-page">
  
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>
<%- include("partials/user-navbar") %>
  
  <!-- Hero -->
 <!-- DYNAMIC BANNER -->

<section
class="hero-section"
id="homeBanner"
>

<div class="hero-text">

  <p class="small-text">
    Featured
  </p>

  <h1 id="bannerTitle">
    Discover our latest collection
  </h1>

  <p
    class="hero-desc"
    id="bannerSubtitle"
  >
    Shop the latest styles at Alder & Ash.
  </p>

  <a
  href="/api/users/products"
  class="hero-btn"
  id="bannerButton"
>
  Explore Now
</a>

</div>


<div class="hero-image">

  <img
    id="bannerImage"
    src=""
    alt="Home Banner"
    style="display:none;"
  >

</div>

</section>
  <!-- New Collection -->
  <section class="collection-banner">
    <h2>New Collection</h2>
    <p>Latest arrivals for every occasion</p>
  </section>

  <!-- Products -->
  <section class="products-section">

    <% newProducts.forEach(product => { %>
  
      <div
        class="product-card"
        onclick="window.location.href='/user/product-details?id=<%= product._id %>'"
      >
  
        <div class="product-image">
          <img
            src="<%= product.images[0] %>"
            alt="<%= product.productName %>"
          >
        </div>
  
        <h4>
          <%= product.productName %>
        </h4>
  
        <p>
          ₹<%= Math.min(...product.variants.map(v => v.price)) %>
        </p>
  
      </div>
  
    <% }) %>
  
  </section>


  <section class="brands-section">
    <h3>Top Brands</h3>
  
    <div class="brands-row">
      <% brands.forEach(brand => { %>
  
        <span>
          <%= brand.brandName %>
        </span>
  
      <% }) %>
    </div>
  </section>

  <!-- Deal Section -->
  <section class="deal-section">
    <img
    class="deal-image"
    src="/images/PngItem_4001105.png"
    alt="Exclusive Deal"
  />

    <div class="deal-content">
      <% if (offer) { %>

        <h3><%= offer.name %></h3>
      
        <p>
          <%= offer.discountType === "PERCENTAGE"
            ? `${offer.discountValue}% OFF`
            : `₹${offer.discountValue} OFF`
          %>
        </p>
      
      <% } else { %>
      
        <h3>No Active Offer</h3>
        <p>Check back soon for our latest deals.</p>
      
      <% } %>

      

      <a href="/api/users/products" class="hero-btn">
        Shop Now
      </a>
    </div>
  </section>
  <script>

    async function loadHomeBanner() {
    
      try {
    
        const response =
          await fetch(
            "/api/users/banner"
          );
    
        const data =
          await response.json();
    
    
        if (
          !response.ok ||
          !data.success ||
          !data.banner
        ) {
          return;
        }
    
    
        const banner =
          data.banner;
    
    
        const title =
          document.getElementById(
            "bannerTitle"
          );
    
        const subtitle =
          document.getElementById(
            "bannerSubtitle"
          );
    
        const button =
          document.getElementById(
            "bannerButton"
          );
    
        const image =
          document.getElementById(
            "bannerImage"
          );
    
    
        title.textContent =
          banner.title ||
          "Discover our latest collection";
    
    
        subtitle.textContent =
          banner.subtitle || "";
    
    
        button.textContent =
          banner.buttonText ||
          "Explore Now";
    
    
        button.href =
          banner.buttonLink ||
          "/api/users/products";
    
    
        if (banner.image) {
    
          image.src =
            banner.image;
    
          image.style.display =
            "block";
        }
    
      } catch (error) {
    
        console.log(
          "HOME BANNER ERROR:",
          error
        );
      }
    
    }
    
    loadHomeBanner();
    
    </script>
  <script src="/js/auth.js"></script>

</body>
</html>