<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Home - ShopHub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="home-page">
  
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>
<%- include("partials/user-navbar") %>
  
  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-text">
      <p class="small-text">Built for your best fit</p>
      <h1>Elevate your shopping experience today!</h1>
      <p class="hero-desc">
        Discover timeless fashion crafted for comfort and confidence.
      </p>
      <a href="/api/users/products" class="hero-btn">Explore Now</a>
    </div>

    <div class="hero-image">

      <% newProducts.slice(0, 3).forEach(product => { %>
    
        <% if (product.images && product.images.length > 0) { %>
          <img
            src="<%= product.images[0] %>"
            alt="<%= product.productName %>"
          >
        <% } %>
    
      <% }) %>
    
    </div>
  </section>

  <!-- New Collection -->
  <section class="collection-banner">
    <h2>New Collection</h2>
    <p>Latest arrivals for every occasion</p>
  </section>

  <!-- Products -->
  <section class="products-section">

    <% newProducts.forEach(product => { %>
  
      <div
        class="product-card"
        onclick="window.location.href='/user/product-details?id=<%= product._id %>'"
      >
  
        <div class="product-image">
          <img
            src="<%= product.images[0] %>"
            alt="<%= product.productName %>"
          >
        </div>
  
        <h4>
          <%= product.productName %>
        </h4>
  
        <p>
          ₹<%= Math.min(...product.variants.map(v => v.price)) %>
        </p>
  
      </div>
  
    <% }) %>
  
  </section>


  <section class="brands-section">
    <h3>Top Brands</h3>
  
    <div class="brands-row">
      <% brands.forEach(brand => { %>
  
        <span>
          <%= brand.brandName %>
        </span>
  
      <% }) %>
    </div>
  </section>

  <!-- Deal Section -->
  <section class="deal-section">
    <img
    class="deal-image"
    src="/images/PngItem_4001105.png"
    alt="Exclusive Deal"
  />

    <div class="deal-content">
      <% if (offer) { %>

        <h3><%= offer.name %></h3>
      
        <p>
          <%= offer.discountType === "PERCENTAGE"
            ? `${offer.discountValue}% OFF`
            : `₹${offer.discountValue} OFF`
          %>
        </p>
      
      <% } else { %>
      
        <h3>No Active Offer</h3>
        <p>Check back soon for our latest deals.</p>
      
      <% } %>

      <div class="timer-box">
        <div><strong>05</strong><span>Days</span></div>
        <div><strong>15</strong><span>Hours</span></div>
        <div><strong>40</strong><span>Min</span></div>
      </div>

      <a href="/api/users/products" class="hero-btn">
        Shop Now
      </a>
    </div>
  </section>
  <script src="/js/auth.js"></script>

</body>
</html>