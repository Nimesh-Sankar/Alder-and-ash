<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP</title>
  <link rel="stylesheet" href="/css/style.css">
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="login-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="login-wrapper">
    <div class="login-brand">Alder & Ash.</div>

    <div class="login-card">
      <div class="login-icon">✓</div>

      <h2>Verify OTP</h2>
      <p class="login-subtitle">
        Enter the code sent to your email
      </p>

      <form id="verifyResetOtpForm" class="login-form">

        <div class="signup-field">
          <input
            type="text"
            id="resetOtp"
            maxlength="6"
            placeholder="Enter OTP"
            required
          >
          <small class="input-error" id="resetOtpError"></small>
        </div>

        <button type="submit" class="login-btn">
          Continue
        </button>
        <p id="resetTimerDisplay" class="otp-timer"></p>
        <button
        id="resendResetOtpBtn"
        type="button"
        class="otp-resend">Resend OTP</button>

        <p class="login-footer">
          Didn’t receive code?
          <a href="/forgot-password">Go back</a>
        </p>

      </form>
    </div>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>