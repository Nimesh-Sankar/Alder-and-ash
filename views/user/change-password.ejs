<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Change Password</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="profile-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="profile-container" style="max-width: 760px;">
    <div class="profile-logo">Alder & Ash.</div>

    <div class="profile-info-card">
      <h2>Change Password</h2>
      <p style="margin-bottom:20px; color:#777;">
        Update your password to keep your account secure
      </p>

      <div class="profile-alert warning">
        <strong>Important Security Information</strong>
        <ul>
          <li>Changing your password will log you out of all devices</li>
          <li>You may need to sign in again</li>
          <li>Choose a strong password you haven’t used before</li>
        </ul>
      </div>

      <div class="profile-info-grid" style="grid-template-columns:1fr;">
        <div>
          <span class="profile-label">Current Password</span>
          <input type="password" id="currentPassword" />
        </div>

        <div>
          <span class="profile-label">New Password</span>
          <input type="password" id="newPassword" />
        </div>

        <div>
          <span class="profile-label">Confirm New Password</span>
          <input type="password" id="confirmPassword" />
        </div>
      </div>

      <div class="profile-actions">
        <button onclick="window.location.href='/user/profile'">
          Cancel
        </button>

        <button onclick="changePassword()">
          Change Password
        </button>
      </div>
    </div>
  </div>

  <script src="/js/user.js"></script>
</body>
</html>