<!DOCTYPE html>
<html>

<head>

    <title>Cancel Order</title>

    <link rel="stylesheet"
        href="/css/orders.css">

    <link rel="stylesheet"
        href="/css/products.css">

    <link rel="stylesheet"
        href="/css/navbar.css">

</head>

<body>

    <%- include("../partials/products-navbar") %>

    <div class="orders-container">

        <h1 class="page-title">
            Cancel Order
        </h1>

        <div class="orders-card">

            <h2>
                <%= order.items[0].product.productName %>
            </h2>

            <p>
                Order ID:
                <%= order.orderId %>
            </p>

            <p>
                Status:
                <span class="status">
                    <%= order.status %>
                </span>
            </p>

            <p>
                Quantity:
                <%= order.items[0].quantity %>
            </p>

            <form method="POST">

                <label for="reason">
                    Cancellation Reason
                </label>
                
                <select name="reason" id="reason" required>
                
                    <option value="" disabled selected>
                        Select a reason
                    </option>
                
                    <option value="Changed my mind">
                        Changed my mind
                    </option>
                
                    <option value="Ordered by mistake">
                        Ordered by mistake
                    </option>
                
                    <option value="Found a better price">
                        Found a better price
                    </option>
                
                    <option value="Product no longer needed">
                        Product no longer needed
                    </option>
                
                    <option value="Delivery taking too long">
                        Delivery taking too long
                    </option>
                
                    <option value="Other">
                        Other
                    </option>
                
                </select>

                <br><br>

                <button
                    type="submit"
                    class="orders-btn">

                    Confirm Cancellation

                </button>

            </form>

        </div>

    </div>

</body>

</html>