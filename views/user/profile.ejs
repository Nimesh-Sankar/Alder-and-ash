<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Profile</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="profile-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="profile-container">

    <div class="profile-logo">Alder & Ash.</div>

    <div class="profile-header-card">
      <div class="profile-avatar-wrap">
        <img id="profileImage" alt="Profile" class="profile-avatar" />
      </div>

      <div class="profile-header-info">
        <h2>
          <span id="profileHeaderFirstName"></span>
          <span id="profileHeaderLastName"></span>
        </h2>

        <p>Member account</p>
      </div>

      <div class="profile-header-links">
        <a href="#">Orders</a>
        <a href="#">Wishlist</a>
        <a href="#" onclick="logoutUser()">Logout</a>
      </div>
    </div>

    <div class="profile-main-grid">

      <div class="profile-info-card">
        <h3>Personal Information</h3>

        <div class="profile-info-grid">
          <div>
            <span class="profile-label">First Name</span>
            <p id="profileFirstName"></p>
          </div>

          <div>
            <span class="profile-label">Last Name</span>
            <p id="profileLastName"></p>
          </div>

          <div>
            <span class="profile-label">Email Address</span>
            <p id="profileEmail"></p>
          </div>

          <div>
            <span class="profile-label">Phone Number</span>
            <p id="profilePhone"></p>
          </div>
        </div>

        <div class="profile-actions">
          <button onclick="window.location.href='/user/edit-profile'">
            Edit Profile
          </button>
          <button onclick="window.location.href='/user/change-password'">
            Change Password
          </button>
        </div>
      </div>
      

      <div class="profile-side-card">
        <h3>Saved Addresses</h3>
        <div style="display:flex; justify-content:space-between; align-items:center;">
        
          <a href="/user/addresses" class="add-address-btn">+ Add</a>
        </div>
        
        <div id="addressList"></div>
        <div id="addressList"></div>
      </div>

    </div>
  </div>

  <script src="/js/user.js"></script>
</body>
</html>