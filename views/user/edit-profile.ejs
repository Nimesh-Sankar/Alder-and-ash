<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Profile</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="profile-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="profile-container">

    <div class="profile-logo">Alder & Ash.</div>

    <div class="profile-main-grid">

      <!-- Left card -->
      <div class="profile-side-card" style="text-align:center;">
        <img
          id="profileImage"
          src="/images/default-avatar.png"
          alt="Profile"
          class="profile-avatar"
          style="margin-bottom: 16px;"
        />

        <h3 style="margin-bottom: 6px;">My Profile</h3>
        <p style="color:#666; font-size:14px;">Update your personal details</p>
      </div>

      <!-- Right card -->
      <div class="profile-info-card">
        <h3>Edit Personal Information</h3>

        <div class="profile-info-grid">

          <div>
            <span class="profile-label">First Name</span>
            <input type="text" id="editFirstName" class="profile-input" />
          </div>

          <div>
            <span class="profile-label">Last Name</span>
            <input type="text" id="editLastName" class="profile-input" />
          </div>

          <div>
            <span class="profile-label">Email</span>
            <input type="email" id="editEmail" class="profile-input" />
          </div>

          <div>
            <span class="profile-label">Phone</span>
            <input type="text" id="editPhone" class="profile-input" />
          </div>

        </div>

        <div class="profile-actions">
          <button onclick="window.location.href='/user/profile'">
            Cancel
          </button>

          <button onclick="saveProfile()">
            Save Changes
          </button>
        </div>
      </div>

    </div>
  </div>

  <script src="/js/user.js"></script>
</body>
</html>