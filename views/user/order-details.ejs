<!DOCTYPE html>
<html>
<head>
    <title>Order Details</title>

    <link rel="stylesheet" href="/css/orders.css">
    <link rel="stylesheet" href="/css/order-details.css">
    <link rel="stylesheet" href="/css/navbar.css">
</head>

<body>
    <%
    const statusLabels = {
        PLACED: "Order Placed",
        CANCELLED: "Cancelled",
        DELIVERED: "Delivered",
        RETURN_REQUESTED: "Return Requested",
        RETURNED: "Returned"
    };
%>

<%- include("../partials/products-navbar") %>

<div class="orders-container">

    <h1 class="page-title">Order Details</h1>

    <div class="orders-card">
        
        <h3>Order #<%= order.orderId %></h3>

        <p>
            Status:
            <span class="status">
                <%= statusLabels[order.status] || order.status %>
            </span>
        </p>

        <p>
            Placed on:
            <%= order.createdAt.toDateString() %>
        </p>

        <p>
            Total:
            ₹<%= order.grandTotal %>
        </p>

        <% if(order.address){ %>

            <div class="address-card">
            
                <h3>Delivery Address</h3>
            
                <p><%= order.address.fullName %></p>
<p><%= order.address.phone %></p>
<p><%= order.address.line1 %></p>
<p><%= order.address.city %></p>
<p><%= order.address.state %></p>
<p><%= order.address.pincode %></p>
            
            </div>
            
            <% } %>

    </div>

    <% order.items.forEach(item => { %>

        <div class="product-card">

            <img
                src="<%= item.product.images[0] %>"
                alt="<%= item.product.productName %>"
                class="product-image"
            >

            <div class="product-info">

                <h3>
                    <%= item.product.productName %>
                </h3>

                <p>
                    Quantity:
                    <%= item.quantity %>
                </p>

                <p>
                    Size:
                    <%= item.size %>
                </p>

                <p>
                    Color:
                    <%= item.color %>
                </p>

                <p>
                    Price:
                    ₹<%= item.price %>
                </p>

                <p>
                    Status:
                    <%= statusLabels[item.status || order.status] || item.status || order.status %>
                </p>

                <div class="order-actions">
                    <% if(
                        order.status === "PLACED" &&
                        item.status !== "CANCELLED"
                    ){ %>
                    
                        <a
                            href="/api/orders/cancel/<%= order.orderId %>/<%= item._id %>"
                            class="orders-btn"
                        >
                            Cancel Item
                        </a>
                    
                    <% } %>
                
                    <% if(
    order.status === "DELIVERED" &&
    item.status !== "RETURN_REQUESTED" &&
    item.status !== "RETURNED"
){ %>

    <a
        href="/api/orders/return/<%= order.orderId %>/<%= item._id %>"
        class="orders-btn"
    >
        Return Item
    </a>

<% } %>
                
                    <% if(order.status === "RETURN_REQUESTED"){ %>
                
                        <span class="orders-btn disabled-btn">
                            Return Requested
                        </span>
                
                    <% } %>
                
                    <% if(order.status === "RETURNED"){ %>
                
                        <span class="orders-btn disabled-btn">
                            Returned
                        </span>
                
                    <% } %>
                
                </div>

            </div>

        </div>

    <% }) %>

    <div class="order-actions">

        <a
            href="/api/orders/invoice/<%= order.orderId %>"
            class="orders-btn"
        >
            Download Invoice
        </a>

    </div>

</div>

</body>
</html>