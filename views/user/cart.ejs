<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cart</title>

  <link
    rel="stylesheet"
    href="/css/style.css">
  <link rel="stylesheet" href="/css/products.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>
  
  <div id="alertBox"
      class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
      role="alert"
      style="z-index: 9999;">
    </div>
    <%- include("../partials/products-navbar",
    {
      hideCart:true
    }) %>
  

  <div class="cart-page">

    <div class="cart-items-box">
      <h2>Shopping Cart</h2>

      <div id="cartItems"></div>

      <button
        onclick="location.href='/user/checkout'"
      class="checkout-btn">
        Proceed to Checkout →
      </button>
    </div>

    <div class="summary-box">
      <h2>Order Summary</h2>

      <p>
        Subtotal
        <span id="subTotal">₹0</span>
      </p>

      <p>
        Tax
        <span id="tax">₹0</span>
      </p>

      <p>
        Delivery Fee
        <span id="shipping">₹0</span>
      </p>

      <hr>

      <p class="total">
        Total
        <span id="grandTotal">₹0</span>
      </p>
    </div>

  </div>

  <script>
    function showAlert(message, type="success") {
      const alertBox =
        document.getElementById("alertBox");
        if(!alertBox) return;
        alertBox.className = `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3`;
      alertBox.innerText = message;
      alertBox.classList.remove("d-none");
      setTimeout(() => {
        alertBox.classList.add("d-none");
      }, 3000);
    }

    async function loadCart() {

      try {

        const user =
  JSON.parse(
    localStorage.getItem("user")
  );

const response =
  await fetch(
    "/api/cart",
    {
      headers: {
        "userid": user.id || user._id
      }
    }
  );

        const cart =
          await response.json();
          if (!response.ok) {
            showAlert(cart.message,"danger");

            return;
          }

        const container =
          document.getElementById("cartItems");

        container.innerHTML = "";

        if (!cart.items || cart.items.length === 0) {

          container.innerHTML = `
            <p class="empty-cart">
              Your cart is empty
            </p>
          `;

          return;
        }

        cart.items.forEach((item) => {
          const isUnavailable=
          item.isUnavailable||!item.product||item.product.isDeleted||item.product.isListed===false;
          const image=
          item.product?.images?.[0]||"/images/no-image.png";
          const productName=
          item.product?.productName||"unavailable product"

          container.innerHTML += `

            <div class="cart-item ${isUnavailable?"unavailable-cart-item":""}">

              <img
                src="${image}"
              >

              <div class="item-info">

                <h3>
                  ${productName}
                </h3>

                <p>
                  Color: ${item.color}
                </p>

                <p>
                  Size: ${item.size}
                </p>

                <h4>
                  ₹${item.price}
                </h4>
                ${isUnavailable?`<p class="unavailable-text">
                  ${item.unavailableReason||"this item is unavailable"}
                  </p>`
                :""}

              </div>

              <div class="quantity-box">

                <button
                ${isUnavailable ? "disabled" : ""}
                  onclick="
                        updateQuantity(
                    '${item._id}',
                    ${item.quantity - 1}
                  )
                ">
                  -
                </button>

                <span>
                  ${item.quantity}
                </span>

                <button
                    ${isUnavailable ? "disabled" : ""}
                    onclick="
                    updateQuantity(
                    '${item._id}',
                    ${item.quantity + 1}
                  )
                ">
                  +
                </button>

              </div>

              <button
                class="remove-btn"
                onclick="removeItem('${item._id}')"
              >
                🗑
              </button>

            </div>

          `;

        });

        document.getElementById("subTotal").innerText =
          `₹${cart.subTotal}`;

        document.getElementById("tax").innerText =
          `₹${cart.tax}`;

        document.getElementById("shipping").innerText =
          `₹${cart.shipping}`;

        document.getElementById("grandTotal").innerText =
          `₹${cart.grandTotal}`;
          
          
          const hasUnavailable =
  cart.items.some((item) => {

    return (
      item.isUnavailable ||
      !item.product ||
      item.product.isDeleted ||
      item.product.isListed === false
    );

  });

const checkoutBtn =
  document.querySelector(".checkout-btn");

if (hasUnavailable) {

  checkoutBtn.disabled = true;

  checkoutBtn.innerText =
    "Remove unavailable items";

} else {

  checkoutBtn.disabled = false;

  checkoutBtn.innerText =
    "Go to Checkout →";

}

      } catch (error) {

        console.log(error);

      }

    }

    async function updateQuantity(itemId, quantity) {

if (quantity < 1) return;

const user =
  JSON.parse(
    localStorage.getItem("user")
  );

const response =
  await fetch(
    `/api/cart/items/${itemId}`,
    {
      method: "PATCH",

      headers: {
        "Content-Type": "application/json",
        "userid": user.id || user._id
      },

      body: JSON.stringify({
        quantity
      })
    }
  );

const data =
  await response.json();

if (!response.ok) {
  showAlert(data.message,"danger");
  return;
}

loadCart();

}

async function removeItem(itemId) {

const user =
  JSON.parse(
    localStorage.getItem("user")
  );

await fetch(
  `/api/cart/items/${itemId}`,
  {
    method: "DELETE",

    headers: {
      "userid": user.id || user._id
    }
  }
);

loadCart();

}

    loadCart();

  </script>

</body>
</html>
