<!DOCTYPE html>
<html>
<head>
    <title>My Orders</title>
    <link rel="stylesheet" href="/css/orders.css">
    <link rel="stylesheet" href="/css/products.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/navbar.css">
</head>
<body>

<%- include("../partials/products-navbar") %>

<div class="orders-container">

    <h1 class="page-title">
        My Orders
    </h1>

    <% orders.forEach(order => { %>

        <div class="orders-card">
            <% if (order.items && order.items.length > 0 && order.items[0].product) { %>

                <img
                    src="<%= order.items[0].product.images[0] %>"
                    alt="Product"
                    class="order-preview-image"
                >
            
            <% } %>
            <h3>
                <%= order.orderId %>
            </h3>

            <p>
                Date:
                <%= order.createdAt.toDateString() %>
            </p>

            <p>
                Status:
                <span class="status">
                    <%= order.status %>
                </span>
            </p>

            <p>
                Total:
                ₹<%= order.grandTotal %>
            </p>

            <a
                href="/api/orders/details/<%= order.orderId %>"
                class="orders-btn">

                View Details

            </a>
            <% if (order.status === "ORDER_FAILED") { %>

                <button
                type="button"
                class="orders-btn"
                onclick="retryPayment('<%= order.orderId %>')"
            >
                Retry Payment
            </button>            
            <% } %>

        </div>

    <% }) %><% if (totalPages > 1) { %>

        <div class="pagination">
    
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>">
                    Previous
                </a>
            <% } %>
    
            <% for (let i = 1; i <= totalPages; i++) { %>
    
                <a
                    href="?page=<%= i %>"
                    class="<%= currentPage === i ? 'active' : '' %>">
    
                    <%= i %>
    
                </a>
    
            <% } %>
    
            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>">
                    Next
                </a>
            <% } %>
    
        </div>
    
    <% } %>


</div>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    async function retryPayment(orderId) {
    
        try {
    
            const response = await fetch(
                `/api/orders/retry-payment/${orderId}`
            );
    
            const result = await response.json();
    
            if (!response.ok || !result.success) {
                console.error(
                    result.message || "Unable to retry payment"
                );
                return;
            }
    
            const options = {
    
                key: "rzp_test_TMkZpAZPvOVGIC",
    
                amount: result.data.amount,
    
                currency: result.data.currency,
    
                name: "Alder & Ash",
    
                description: `Retry payment for ${orderId}`,
    
                order_id:
                    result.data.razorpayOrderId,
    
                    handler: async function (response) {

try {

    const verifyResponse = await fetch(
        `/api/orders/retry-payment/verify/${orderId}`,
        {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                razorpay_order_id:
                    response.razorpay_order_id,

                razorpay_payment_id:
                    response.razorpay_payment_id,

                razorpay_signature:
                    response.razorpay_signature
            })
        }
    );

    const verifyResult =
        await verifyResponse.json();

    if (
        !verifyResponse.ok ||
        !verifyResult.success
    ) {
        console.error(
            verifyResult.message ||
            "Retry payment verification failed"
        );

        return;
    }

    window.location.href =
        `/api/orders/success/${verifyResult.data.orderId}`;

} catch (error) {

    console.error(
        "RETRY VERIFY ERROR:",
        error
    );
}
}
    
            };
    
            const razorpay =
                new Razorpay(options);
    
            razorpay.open();
    
        } catch (error) {
    
            console.error(
                "RETRY PAYMENT ERROR:",
                error
            );
        }
    }
    </script>
</body>
</html>
