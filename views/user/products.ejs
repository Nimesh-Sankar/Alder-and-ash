<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Products
  </title>

  <link
    rel="stylesheet"
    href="/css/products.css"
  >

</head>

<body>

  <!-- NAVBAR -->

  <nav class="navbar">

    <div class="logo">
      Alder & Ash.
    </div>

    <div class="nav-links">
      

      <a href="/">
        Home
      </a>

      <a href="#">
        About
      </a>

      <a href="#">
        Contact
      </a>

    </div>
   

  </nav>
  
  <div class="listing-controls">

    <input
      type="text"
      id="searchInput"
      placeholder="Search products..."
    >
  
    <button onclick="clearSearch()">
      Clear
    </button>
  
    <select id="sortSelect">
      <option value="">Sort</option>
      <option value="priceLowHigh">Price Low to High</option>
      <option value="priceHighLow">Price High to Low</option>
      <option value="az">A-Z</option>
      <option value="za">Z-A</option>
    </select>
  
    <input
      type="number"
      id="minPrice"
      placeholder="Min price"
    >
  
    <input
      type="number"
      id="maxPrice"
      placeholder="Max price"
    >
  
    <button onclick="applyFilters()">
      Apply
    </button>
  
  </div>

  <!-- MAIN LAYOUT -->

  <div class="shop-layout">

    <!-- SIDEBAR -->

    <div class="sidebar">

      <h2>
        Filters
      </h2>
    
      <div id="categoryFilters"></div>
    <h2>Brands</h2>
    <div id="brandFilters"></div>
    </div>


    <!-- PRODUCTS -->

    <div
      class="products-grid"
      id="productsContainer">

    </div>

  </div> 
  <div class="pagination">
  <button id="prevBtn" onclick="changePage(-1)">Prev</button>  
  <span id="pageNumber">
    1
  </span>
  <button id="nextBtn" onclick="changePage(1)">Next</button>
  </div>

  <script>


async function loadCategories() {

try {

  const response =
    await fetch(
      "http://localhost:3000/admin/categories"
    );

  const data =
    await response.json();

  const container =
    document.getElementById(
      "categoryFilters"
    );

  container.innerHTML = `

    <p
  class="category-item active-category"

  onclick="
    selectCategory(this,'')"
    >
  All
</p>


  `;

  data.categories.forEach(
    (category) => {

      container.innerHTML += `

        <p
  class="category-item"

  onclick="
    selectCategory(
      this,
      '${category._id}'
    )
  "
>
          ${category.name}
        </p>

      `;

    }
  );

} catch (error) {

  console.log(error);

}

}
function selectCategory(element,categoryId){

  document
    .querySelectorAll(
      ".category-item"
    )

    .forEach((item) => {

      item.classList.remove(
        "active-category"
      );

    });

  element.classList.add(
    "active-category"
  );

  currentCategory = categoryId;

  currentPage = 1;
  loadProducts();

}  
function selectBrand(element,brandId){
  
  document
    .querySelectorAll(
      ".brand-item"
    )

    .forEach((item) => {

      item.classList.remove(
        "active-brand"
      );

    });

  element.classList.add(
    "active-brand"
  );

  currentBrand = brandId;

  currentPage = 1;
  loadProducts();
}
let currentCategory = "";
let currentSort = "";
let currentMinPrice = "";
let currentMaxPrice = "";
let currentSearch = "";

let currentPage = 1;
let totalPages = 1;
let currentBrand = "";

async function loadBrands() {

try {

  const response =
    await fetch(
      "http://localhost:3000/admin/brands"
    );

  const data =
    await response.json();

  const container =
    document.getElementById(
      "brandFilters"
    );

  container.innerHTML = `

    <p
      class="brand-item active-brand"

      onclick="
        selectBrand(this, '')
      "
    >
      All Brands
    </p>

  `;

  data.brands.forEach(
    (brand) => {

      container.innerHTML += `

        <p
          class="brand-item"

          onclick="
            selectBrand(
              this,
              '${brand._id}'
            )
          "
        >
          ${brand.brandName}
        </p>

      `;

    }
  );

} catch (error) {

  console.log(error);

}

}

async function loadProducts() {

try {

  const response =
    await fetch(
`http://localhost:3000/admin/products?search=${currentSearch}&category=${currentCategory}&sort=${currentSort}&minPrice=${currentMinPrice}&maxPrice=${currentMaxPrice}&page=${currentPage}&brand=${currentBrand}`
    );

  const data =
    await response.json();
    totalPages =
  data.totalPages || 1; 

document.getElementById(
  "pageNumber"
).innerText = `${currentPage} / ${totalPages}`;

document.getElementById("prevBtn").disabled =
  currentPage === 1;
document.getElementById("nextBtn").disabled =
  currentPage === totalPages;

  const container =
    document.getElementById(
      "productsContainer"
    );

  container.innerHTML = "";
  if(!data.products||data.products.length===0) {
  container.innerHTML = `<p>No products found.</p>`;
    return;
  }
  data.products.forEach(
    (product) => {

      container.innerHTML += `

<div
class="product-card"
onclick="
  viewProduct('${product._id}')
"
>

<img
  src="http://localhost:3000${product.images[0]}"
>

<h3>
  ${product.productName}
</h3>

<p>
  ₹${product.variants[0].price}
</p>



</div>

`;

    }
  );
  

} catch (error) {

  console.log(error);

}

}

function changePage(step) {
  currentPage += step;
  if (currentPage < 1) {
    currentPage = 1;
  } else if (currentPage > totalPages) {
    currentPage = totalPages;
  }
  loadProducts();
}
function clearSearch() {

currentSearch = "";

document.getElementById(
  "searchInput"
).value = "";

loadProducts();

}
function applyFilters() {

currentSort =
  document.getElementById(
    "sortSelect"
  ).value;

currentMinPrice =
  document.getElementById(
    "minPrice"
  ).value;

currentMaxPrice =
  document.getElementById(
    "maxPrice"
  ).value;

  currentPage = 1;
loadProducts();

}
document
  .getElementById("searchInput")

  .addEventListener(
    "keyup",

    (e) => {

      currentSearch =
        e.target.value;
        currentPage = 1;
      loadProducts();
    }
  );
  loadCategories();
  loadBrands();
  loadProducts();

    function viewProduct(id) {

      window.location.href =
        `/user/product-details?id=${id}`;

    }

  </script>

</body>
</html>