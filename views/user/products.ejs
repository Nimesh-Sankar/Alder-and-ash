<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Products
  </title>

  <link
    rel="stylesheet"
    href="/css/products.css"
  >
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body>

  <%- include("../partials/products-navbar") %>
  <div id="alertBox"
      class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
      role="alert"
      style="z-index: 9999;">
    </div>



  <div class="listing-controls">

    <input
      type="text"
      id="searchInput"
      placeholder="Search products..."
    >
  
    <button onclick="clearSearch()">
      Clear
    </button>
  
    <select id="sortSelect">
      <option value="">Sort</option>
      <option value="priceLowHigh">Price Low to High</option>
      <option value="priceHighLow">Price High to Low</option>
      <option value="az">A-Z</option>
      <option value="za">Z-A</option>
    </select>
  
    <input
      type="number"
      id="minPrice"
      placeholder="Min price"
    >
  
    <input
      type="number"
      id="maxPrice"
      placeholder="Max price"
    >
  
    <button onclick="applyFilters()">
      Apply
    </button>
  
  </div>

  <!-- MAIN LAYOUT -->

  <div class="shop-layout">

    <!-- SIDEBAR -->

    <div class="sidebar">

      <h2>
        Filters
      </h2>
    
      <div id="categoryFilters"></div>
    <h2>Brands</h2>
    <div id="brandFilters"></div>
    </div>


    <!-- PRODUCTS -->

    <div
      class="products-grid"
      id="productsContainer">

    </div>

  </div> 
  <div class="pagination">
  <button id="prevBtn" onclick="changePage(-1)">Prev</button>  
  <span id="pageNumber">
    1
  </span>
  <button id="nextBtn" onclick="changePage(1)">Next</button>
  </div>

  <script>
    let wishlistIds = [];

    async function loadWishlist() {

const user =
    JSON.parse(
        localStorage.getItem("user")
    );

if (!user) return;

const response = await fetch(
    "/api/wishlist",
    {
        headers: {
            userid:
                user.id || user._id
        }
    }
);

if (!response.ok) {
    return;
}

const data =
    await response.json();

if (data.wishlist) {

    wishlistIds =
        data.wishlist.products.map(
            product =>
                product._id.toString()
        );
}
}

    function showAlert(
  message,
  type = "success"
) {

  const alertBox =
    document.getElementById(
      "alertBox"
    );

  if (!alertBox) return;

  alertBox.className =
    `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded px-4 py-3`;

  alertBox.textContent =
    message;

  alertBox.classList.remove(
    "d-none"
  );

  setTimeout(() => {

    alertBox.classList.add(
      "d-none"
    );

  }, 3000);

}


async function loadCategories() {

try {

  const response =
    await fetch(
      "/admin/categories"
    );

  const data =
    await response.json();

  const container =
    document.getElementById(
      "categoryFilters"
    );

  container.innerHTML = `

    <p
  class="category-item active-category"

  onclick="
    selectCategory(this,'')"
    >
  All
</p>


  `;

  data.categories
  .filter((category) => category.isListed === true)
  .forEach((category) => {

      container.innerHTML += `

        <p
  class="category-item"

  onclick="
    selectCategory(
      this,
      '${category._id}'
    )
  "
>
          ${category.name}
        </p>

      `;

    }
  );

} catch (error) {

  console.log(error);

}

}
function selectCategory(element,categoryId){

  document
    .querySelectorAll(
      ".category-item"
    )

    .forEach((item) => {

      item.classList.remove(
        "active-category"
      );

    });

  element.classList.add(
    "active-category"
  );

  currentCategory = categoryId;

  currentPage = 1;
  loadProducts();

}  
function selectBrand(element,brandId){
  
  document
    .querySelectorAll(
      ".brand-item"
    )

    .forEach((item) => {

      item.classList.remove(
        "active-brand"
      );

    });

  element.classList.add(
    "active-brand"
  );

  currentBrand = brandId;

  currentPage = 1;
  loadProducts();
}
let currentCategory = "";
let currentSort = "";
let currentMinPrice = "";
let currentMaxPrice = "";
let currentSearch = "";

let currentPage = 1;
let totalPages = 1;
let currentBrand = "";

async function loadBrands() {

try {

  const response =
    await fetch(
      "/admin/brands"
    );

  const data =
    await response.json();

  const container =
    document.getElementById(
      "brandFilters"
    );

  container.innerHTML = `

    <p
      class="brand-item active-brand"

      onclick="
        selectBrand(this, '')
      "
    >
      All Brands
    </p>

  `;

  data.brands.forEach(
    (brand) => {

      container.innerHTML += `

        <p
          class="brand-item"

          onclick="
            selectBrand(
              this,
              '${brand._id}'
            )
          "
        >
          ${brand.brandName}
        </p>

      `;

    }
  );

} catch (error) {

  console.log(error);

}

}

async function loadProducts() {

try {

  const response =
    await fetch(
`/admin/products?search=${currentSearch}&category=${currentCategory}&sort=${currentSort}&minPrice=${currentMinPrice}&maxPrice=${currentMaxPrice}&page=${currentPage}&brand=${currentBrand}&onlyListed=true`
    );

  const data =
    await response.json();
   
    totalPages =
  data.totalPages || 1; 

document.getElementById(
  "pageNumber"
).innerText = `${currentPage} / ${totalPages}`;

document.getElementById("prevBtn").disabled =
  currentPage === 1;
document.getElementById("nextBtn").disabled =
  currentPage === totalPages;

  const container =
    document.getElementById(
      "productsContainer"
    );

  container.innerHTML = "";
  if(!data.products||data.products.length===0) {
  container.innerHTML = `<p>No products found.</p>`;
    return;
  }
 data.products.filter(
    (product) => product.isListed !== false
)
.forEach((product) => {

    const variant = product.variants[0];

    const isOutOfStock =
        !variant || variant.stock <= 0;

    const isWishlisted =
        wishlistIds.includes(
            product._id.toString()
        );

    

      container.innerHTML += `

<div
class="
product-card
${isOutOfStock ? "out-of-stock-card" : ""}
"

onclick="
viewProduct('${product._id}')
"
>
${isOutOfStock
? `
<span class="stock-badge">
Out Of Stock
</span>
`
: ""
}
<img
  src="${product.images[0]}"
>
  <div
  class="wishlist-btn"
  onclick="
  event.stopPropagation();
  addToWishlist('${product._id}', ${isOutOfStock});
  "
  >
  ${isWishlisted ? "❤️" : "🤍"}
  </div>
<p class="product-meta">
${product.brand?.brandName||""}
•
${product.category?.name||""}

<h3>
  ${product.productName}
</h3>

<p>
  ₹${product.variants[0].price}
</p>

<button
  class="cart-btn"

  ${isOutOfStock
    ? "disabled"
    : ""
  }

  onclick="
    event.stopPropagation();

    addProductToCartFromCard(
      '${product._id}',
      '${variant.size}',
      '${variant.color}'
    )
  "
>

${isOutOfStock
  ? "Out Of Stock"
  : "Add To Cart"
}

</button>



</div>

`;

    }
  );
  

} catch (error) {

  console.log(error);

}

}

function changePage(step) {
  currentPage += step;
  if (currentPage < 1) {
    currentPage = 1;
  } else if (currentPage > totalPages) {
    currentPage = totalPages;
  }
  loadProducts();
}
function clearSearch() {

currentSearch = "";

document.getElementById(
  "searchInput"
).value = "";

loadProducts();

}
function applyFilters() {

currentSort =
  document.getElementById(
    "sortSelect"
  ).value;

currentMinPrice =
  document.getElementById(
    "minPrice"
  ).value;

currentMaxPrice =
  document.getElementById(
    "maxPrice"
  ).value;

  currentPage = 1;
loadProducts();

}
document
  .getElementById("searchInput")

  .addEventListener(
    "keyup",

    (e) => {

      currentSearch =
        e.target.value;
        currentPage = 1;
      loadProducts();
    }
  );
  (async function () {

await loadWishlist();

loadCategories();
loadBrands();
loadProducts();

})();

    function viewProduct(id) {

      window.location.href =
        `/user/product-details?id=${id}`;

    }
    async function addProductToCartFromCard(productId,size, color) {

  const user =
    JSON.parse(
      localStorage.getItem("user")
    );

  if (!user) {

    showAlert(
  "Please login first",
  "danger"
);

setTimeout(() => {

  window.location.href =
    "/login";

}, 900);

return;

  }

  const response =
    await fetch(
      "/api/cart/add",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "userid": user.id || user._id
        },

        body: JSON.stringify({
          productId,
          quantity: 1,
          size,
          color
        })
      }
    );

  const data =
    await response.json();

  showAlert(data.message,response.ok
    ?"success"
    :"danger"
  );

}
async function addToWishlist(productId, isOutOfStock) {
  const user = JSON.parse(
    localStorage.getItem("user")
  );

  if (!user) {
    showAlert(
      "Please login first",
      "danger"
    );

    setTimeout(() => {
      window.location.href = "/login";
    }, 900);

    return;
  }

  if (isOutOfStock) {
    showAlert(
      "This product is out of stock",
      "danger"
    );
    return;
  }

  try {
    if (wishlistIds.includes(productId)) {

      // REMOVE FROM WISHLIST
      const response = await fetch(
        "/api/wishlist/remove",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            productId
          })
        }
      );

      const data = await response.json();

      showAlert(
        data.message || "Removed from wishlist",
        response.ok ? "success" : "danger"
      );

      if (response.ok) {
        wishlistIds = wishlistIds.filter(
          id => id !== productId
        );
      }

    } else {

    
      const response = await fetch(
        "/api/wishlist/add",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            productId
          })
        }
      );

      const data = await response.json();

      showAlert(
        data.message || "Unable to update wishlist",
        response.ok ? "success" : "danger"
      );

      if (response.ok) {
        wishlistIds.push(productId);
      }
    }

    loadProducts();

  } catch (error) {
    console.log(
      "WISHLIST ERROR:",
      error
    );

    showAlert(
      "Something went wrong",
      "danger"
    );
  }
}



  </script>

</body>
</html>
