<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Verify Email Change</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
</head>

<body class="login-page">

  <div
    id="alertBox"
    class="alert d-none position-fixed top-0 end-0 m-3"
    role="alert"
    style="z-index: 9999;"
  ></div>

  <div class="otp-page">

    <div class="otp-card">

      <a
        href="/user/edit-profile"
        class="otp-close"
      >
        &times;
      </a>

      <div class="otp-icon">
        📧
      </div>

      <h2>
        Verify Email Change
      </h2>

      <p class="otp-subtitle">
        Enter the OTP sent to your new email
      </p>

      <form id="emailOtpForm">

        <input
          type="text"
          id="emailOtp"
          maxlength="6"
          placeholder="Enter OTP"
          required
        />

        <button
          type="submit"
          class="login-btn"
        >
          Verify OTP
        </button>

      </form>

      <div class="otp-footer">

        <p id="otpTimer">
          Resend OTP in 30s
        </p>

        <button
          id="resendEmailOtpBtn"
          type="button"
          class="otp-resend"
          style="display: none;"
        >
          Resend OTP
        </button>

      </div>

    </div>

  </div>

  <script src="/js/user.js"></script>

</body>

</html>