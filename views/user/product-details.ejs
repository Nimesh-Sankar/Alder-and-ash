<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <title>
    Product Details
  </title>

  <link
    rel="stylesheet"
    href="/css/products.css"
  >
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

</head>

<body class="home-page">

  <div id="alertBox"
      class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
      role="alert"
      style="z-index: 9999;">
    </div>

  <%- include("../partials/products-navbar") %>
  <div class="breadcrumb" id="breadcrumb">
    Home / Products / Product
  </div>
  <div id="productDetails"></div>
  <div class="related-section">

    <h2>
      Related Products
    </h2>
  
    <div
      id="relatedProducts"
      class="related-products"
    ></div>
  
  </div>

  <script>

    function showAlert(message, type="success") {
      const alertBox =
        document.getElementById("alertBox");
        if(!alertBox) return;
        alertBox.className = `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3`;
      alertBox.innerText = message;
      alertBox.classList.remove("d-none");
      setTimeout(() => {
        alertBox.classList.add("d-none");
      }, 3000);
    }

    let selectedVariant = null;
  
    async function loadProduct() {
  
      const params =
        new URLSearchParams(
          window.location.search
        );
  
      const id =
        params.get("id");
  
      try {
  
        const response =
          await fetch(
            `/admin/products/${id}`
          );
  
        const data =
          await response.json();
          console.log("PRODUCT RESPONSE:", response);
console.log("PRODUCT DATA:", data);
  
        const product = data.product;
          const offer = data.offer;
  
        if (
          !response.ok ||
          !product ||
          product.isDeleted
        ) {
  
          window.location.href =
            "/api/users/products";
  
          return;
  
        }
  
        selectedVariant =
          product.variants[0];
  
        document.getElementById(
          "breadcrumb"
        ).innerHTML = `
          <a href="/">Home</a>
          /
          <a href="/api/users/products">Products</a>
          /
          <span>${product.productName}</span>
        `;
  
        if (product.category) {
  loadRelatedProducts(
    product.category._id || product.category,
    product._id
  );
}
  
        document.getElementById(
          "productDetails"
        ).innerHTML = `
  
          <div class="product-page">
  
            <div class="gallery">
  
              <div class="image-zoom-wrapper">

  <img
    class="main-img"
    src="${product.images[0]}"
    onclick="openImageZoom(this.src)"
    onmousemove="handleImageZoom(event, this)"
    onmouseenter="showZoomPreview(this)"
    onmouseleave="hideZoomPreview()"
  >

  <div
    id="zoomPreview"
    class="zoom-preview"
  ></div>

</div>
  
              <div class="small-images">
  
                ${product.images.map((image) => `
  
                  <img
                    src="${image}"
                    onclick="changeMainImage(this.src)"
                  >
  
                `).join("")}
  
              </div>
  
            </div>
  
            <div class="product-info">
  
              <h1>
                ${product.productName}
              </h1>
  
              <div class="rating-box">
                ★★★★☆
                <span>(24 reviews)</span>
              </div>
  
              <p class="price" id="productPrice">
                ₹${product.variants[0].price}
              </p>
  
<div class="offer-box">
  ${
    offer
      ? `
        <p>
          ${offer.discountType === "PERCENTAGE"
            ? `Save ${offer.discountValue}%`
            : `Save ₹${offer.discountValue}`
          }
        </p>
      `
      : `
        <p>No offer available</p>
      `
  }
</div>
  
              <p class="stock-info" id="stockInfo">
                ${
                  product.variants[0].stock > 0
                    ? `In Stock: ${product.variants[0].stock}`
                    : `Out Of Stock`
                }
              </p>
  
              <p class="description">
                ${product.description}
              </p>
  
              <div class="highlights">
  
                <h3>Highlights</h3>
  
                <ul>
                  <li>Premium quality fabric</li>
                  <li>Comfortable fit</li>
                  <li>Easy return available</li>
                  <li>Fast delivery</li>
                </ul>
  
              </div>
  
              <h3>Select Size / Color</h3>
  
              <div class="sizes">
  
                ${product.variants.map((variant, index) => `
  
                  <button
                    class="variant-btn ${index === 0 ? "active-size" : ""}"
                    onclick="
                      selectVariant(
                        '${variant.size}',
                        '${variant.color}',
                        ${variant.price},
                        ${variant.stock},
                        this
                      )
                    "
                  >
                    ${variant.size} / ${variant.color}
                  </button>
  
                `).join("")}
  
              </div>
              
             <div class="actions">

    <button
      id="addToCartBtn"
      class="cart-btn"
      onclick="addToCart()"
      ${
        product.variants[0].stock <= 0
          ? "disabled"
          : ""
      }
    >
      ${
        product.variants[0].stock <= 0
          ? "Out Of Stock"
          : "Add To Cart"
      }
    </button>

    <button
      class="wishlist-detail-btn"
      onclick="addToWishlist('${product._id}')" >
      ❤️ Add to Wishlist
    </button>

</div>

</div> 
</div>   
`;
  
      } catch (error) {
  
        console.log(error);
  
      }
  
    }
  
    function selectVariant(
  size,
  color,
  price,
  stock,
  button
) {

  selectedVariant = {
    size,
    color,
    price,
    stock
  };

  document.getElementById(
    "productPrice"
  ).innerText = `₹${price}`;

  document.getElementById(
    "stockInfo"
  ).innerText =
    stock > 0
      ? `In Stock: ${stock}`
      : "Out Of Stock";

  const cartButton =
    document.getElementById("addToCartBtn");

  if (stock <= 0) {
    cartButton.disabled = true;
    cartButton.innerText = "Out Of Stock";
  } else {
    cartButton.disabled = false;
    cartButton.innerText = "Add To Cart";
  }

  document
    .querySelectorAll(".variant-btn")
    .forEach((btn) => {
      btn.classList.remove("active-size");
    });

  button.classList.add("active-size");

}
  
    async function addToCart() {
      const user =
  JSON.parse(
    localStorage.getItem("user")
  );

if (!user) {

  showAlert(
  "Please login first",
  "danger"
);

setTimeout(() => {

  window.location.href =
    "/login";

}, 900);

return;

}
 try {
  
        const params =
          new URLSearchParams(
            window.location.search
          );
  
        const productId =
          params.get("id");
  
        const response =
          await fetch(
            "/api/cart/add",
            {
              method: "POST",
  
              headers: {
                "Content-Type": "application/json",
                "userid": user.id || user._id
              },
  
              body: JSON.stringify({
                productId,
                quantity: 1,
                size: selectedVariant.size,
                color: selectedVariant.color
              })
            }
          );
  
        const data =
          await response.json();
  
        showAlert(
          data.message,
          response.ok?"success":"danger"
        );
  
        
  
      } catch (error) {
  
        console.log(error);
  
      }
  
    }
async function addToWishlist(productId) {
  const user = JSON.parse(localStorage.getItem("user"));

  if(!user){
    showAlert("Please login first", "danger");
    return;
  }
  const response= await fetch("/api/wishlist/add", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "userid": user.id || user._id
    },
    body: JSON.stringify({ productId })
  });
  const data=await response.json();
  showAlert(data.message, response.ok?"success":"danger");  
  
  
}

  
function changeMainImage(imageUrl) {

const mainImage =
  document.querySelector(".main-img");

mainImage.src = imageUrl;

const preview =
  document.getElementById("zoomPreview");

if (preview) {
  preview.style.backgroundImage =
    `url('${imageUrl}')`;
}
}
    function showZoomPreview(image) {

const preview =
  document.getElementById("zoomPreview");

preview.style.backgroundImage =
  `url('${image.src}')`;

preview.style.display = "block";
}

function hideZoomPreview() {

const preview =
  document.getElementById("zoomPreview");

preview.style.display = "none";
}

function handleImageZoom(event, image) {

const preview =
  document.getElementById("zoomPreview");

const rect =
  image.getBoundingClientRect();

const x =
  ((event.clientX - rect.left) / rect.width) * 100;

const y =
  ((event.clientY - rect.top) / rect.height) * 100;

preview.style.backgroundPosition =
  `${x}% ${y}%`;
}
    function openImageZoom(imageUrl){
      const modal=
      document.getElementById("imageZoomModal");
      const zoomedImage=
      document.getElementById("zoomedImage");
      zoomedImage.src=imageUrl;
      modal.style.display="flex";

    }
    function closeImageZoom(){
      document.getElementById("imageZoomModal").style.display="none";
    }
  
    async function loadRelatedProducts(
      categoryId,
      currentProductId
    ) {
  
      try {
  
        const response =
          await fetch(
            `/admin/products?category=${categoryId}`
          );
  
        const data =
          await response.json();
  
        const container =
          document.getElementById(
            "relatedProducts"
          );
  
        container.innerHTML = "";
  
        data.products
          .filter(
            (product) =>
              product._id !== currentProductId
          )
          .slice(0, 4)
          .forEach((product) => {
  
            container.innerHTML += `
  
              <div
                class="related-card"
                onclick="
                  viewRelatedProduct('${product._id}')
                "
              >
  
                <img
                  src="${product.images[0]}"
                >
  
                <h3>
                  ${product.productName}
                </h3>
  
                <p>
                  ₹${product.variants[0].price}
                </p>
  
              </div>
  
            `;
  
          });
  
      } catch (error) {
  
        console.log(error);
  
      }
  
    }
  
    function viewRelatedProduct(id) {
  
      window.location.href =
        `/user/product-details?id=${id}`;
  
    }
  
    loadProduct();
  
  </script>
<div id="imageZoomModal" class="zoom-modal">
  <span class="zoom-close" onclick="closeImageZoom()">
    &times;
  </span>
<img id="zoomedImage" class="zoomed-images">
</div>


</body>
</html>
