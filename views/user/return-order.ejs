<!DOCTYPE html>
<html>

<head>

    <title>Return Order</title>

    <link rel="stylesheet"
        href="/css/orders.css">

    <link rel="stylesheet"
        href="/css/products.css">

    <link rel="stylesheet"
        href="/css/navbar.css">

</head>

<body>

    <%- include("../partials/products-navbar") %>

    <div class="orders-container">

        <h1 class="page-title">
            Return Order
        </h1>

        <div class="orders-card">

            <h2>
                <%= order.items[0].product.productName %>
            </h2>

            <p>
                Order ID:
                <%= order.orderId %>
            </p>

            <p>
                Status:
                <span class="status">
                    <%= order.status %>
                </span>
            </p>

            <p>
                Quantity:
                <%= order.items[0].quantity %>
            </p>

            <form method="POST">

                <label for="reason">
                    Return Reason
                </label>
                
                <select name="reason" id="reason" required>
                
                    <option value="" disabled selected>
                        Select a reason
                    </option>
                
                    <option value="Product is damaged">
                        Product is damaged
                    </option>
                
                    <option value="Wrong product received">
                        Wrong product received
                    </option>
                
                    <option value="Wrong size or fit">
                        Wrong size or fit
                    </option>
                
                    <option value="Product does not match description">
                        Product does not match description
                    </option>
                
                    <option value="Product quality issue">
                        Product quality issue
                    </option>
                
                    <option value="Other">
                        Other
                    </option>
                
                </select>
                <br><br>

                <button
                    type="submit"
                    class="orders-btn">

                    submit return request

                </button>

            </form>

        </div>

    </div>

</body>

</html>