<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>

    <link rel="stylesheet" href="/css/products.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/checkout.css">
</head>

<body>

    <%- include("../partials/products-navbar") %>

    <div class="checkout-container">

        <!-- LEFT SIDE -->
        <div class="checkout-left">

            <h2>Checkout</h2>

            <div class="address-section">

                <div class="section-header">
                    <h3>Shipping Address</h3>

                    <button id="addAddressBtn"
                    onclick="location.href='/user/profile?tab=addresses'">
                        + Add Address
                    </button>
                </div>

                <div id="addressContainer">

                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="checkout-right">

            <h3>Order Summary</h3>

            <div id="cartItems">

            </div>

            <div class="summary">

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="subtotal">₹0</span>
                </div>

                <div class="summary-row">
                    <span>Tax</span>
                    <span id="tax">₹0</span>
                </div>

                <div class="summary-row">
                    <span>Shipping</span>
                    <span id="shipping">₹0</span>
                </div>

                <div class="summary-row total">
                    <span>Total</span>
                    <span id="grandTotal">₹0</span>
                </div>

            </div>

            <div class="payment-method">

              <h4>Payment Method</h4>
          
              <label>
                  <input
                      type="radio"
                      checked
                      name="payment"
                      value="COD"
                  >
                  Cash On Delivery
              </label>
          
              <label>
                  <input
                      type="radio"
                      name="payment"
                      value="RAZORPAY"
                  >
                  Razorpay
              </label>
          
          </div>

            <button id="placeOrderBtn" type="button">
                Place Order
            </button>

        </div>

    </div>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  async function loadAddresses(){
    const user=JSON.parse(localStorage.getItem("user"));

    const response=await fetch(`/api/addresses/${user.id || user._id}`);
    
    
    const data=await response.json();
    
    const container=document.getElementById("addressContainer");
    
    container.innerHTML="";
    
    data.addresses.forEach((address)=>{
      container.innerHTML+=`
        <div class="address-card">
          <label>
            <input
              type="radio"
              name="address"
              value="${address._id}"${address.isDefault ? " checked" : ""}
            >
            <strong>${address.label}</strong><br>
            ${address.fullName}<br>
            ${address.phone}<br>
            ${address.line1}, ${address.street}, ${address.city}, ${address.state} - ${address.pincode}<br>
            </label>
        </div>
      `;
    }); 

  }
  async function loadCart() {

const user = JSON.parse(localStorage.getItem("user"));

const response = await fetch("/api/cart", {
    headers: {
        userid: user.id || user._id
    }
});

const cart = await response.json();

const container = document.getElementById("cartItems");

container.innerHTML = "";

cart.items.forEach((item) => {

    container.innerHTML += `

    <div class="cart-item">

        <img src="${item.product.images[0]}">

        <div class="cart-info">

            <h4>${item.product.productName}</h4>

            <p>Size: ${item.size}</p>

            <p>Color: ${item.color}</p>

            <p>Qty: ${item.quantity}</p>

            <strong>₹${item.price * item.quantity}</strong>

        </div>

    </div>

    `;

});

document.getElementById("subtotal").innerText =
    `₹${cart.subTotal}`;

document.getElementById("tax").innerText =
    `₹${cart.tax}`;

document.getElementById("shipping").innerText =
    `₹${cart.shipping}`;

document.getElementById("grandTotal").innerText =
    `₹${cart.grandTotal}`;
}

  loadAddresses();
  loadCart();

  document.getElementById("placeOrderBtn").addEventListener("click", async () => {
    const selectedAddress = document.querySelector('input[name="address"]:checked');
    const selectedPayment = document.querySelector('input[name="payment"]:checked');
    const button = document.getElementById("placeOrderBtn");

    if (!selectedAddress) {
      alert("Please select a shipping address.");
      return;
    }

    button.disabled = true;
    button.textContent = "Placing Order...";

    try {

const paymentMethod =
    selectedPayment
        ? selectedPayment.value
        : "COD";

if (paymentMethod === "COD") {

    const response = await fetch("/api/orders", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            addressId: selectedAddress.value,
            paymentMethod: "COD"
        })
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
        throw new Error(
            result.message ||
            "Unable to place your order."
        );
    }

    window.location.href =
        `/api/orders/success/${result.data.orderId}`;

    return;
}

if (paymentMethod === "RAZORPAY") {

const response = await fetch(
    "/api/orders/create-payment",
    {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            addressId: selectedAddress.value
        })
    }
);

const result = await response.json();

if (!response.ok || !result.success) {

    throw new Error(
        result.message ||
        "Unable to create payment"
    );

}

const options = {

    key: "rzp_test_TMkZpAZPvOVGIC",

    amount: result.data.amount,

    currency: result.data.currency,

    name: "Alder & Ash",

    description: "Order Payment",

    order_id:
        result.data.razorpayOrderId,

        handler: async function (response) {

try {

    console.log("RAZORPAY RESPONSE:", response);

    const verifyResponse = await fetch(
        "/api/orders/verify-payment",
        {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                razorpay_order_id:
                    response.razorpay_order_id,

                razorpay_payment_id:
                    response.razorpay_payment_id,

                razorpay_signature:
                    response.razorpay_signature,

                addressId:
                    selectedAddress.value
            })
        }
    );

    const result = await verifyResponse.json();

    console.log("VERIFY RESPONSE:", result);

    if (!verifyResponse.ok || !result.success) {
        throw new Error(
            result.message ||
            "Payment verification failed"
        );
    }

    console.log("ORDER ID:", result.data.orderId);

    window.location.href =
        `/api/orders/success/${result.data.orderId}`;

} catch (error) {

    console.error("PAYMENT ERROR:", error);

    alert(error.message);

    button.disabled = false;
    button.textContent = "Place Order";
}
},

    theme: {
        color: "#000000"
    }

};

const razorpay =
new Razorpay(options);

razorpay.on("payment.failed", function () {

    window.location.href =
        "/api/orders/order-failed";

});

razorpay.open();

}

} catch (error) {

alert(error.message);

button.disabled = false;
button.textContent = "Place Order";

}
  });
</script>
</body>

</html>
