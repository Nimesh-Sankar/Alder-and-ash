<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title id="pageTitle">Add Address</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>

<body class="profile-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="address-form-container">

    <h2 id="formHeading">Add a new address</h2>
    <p class="form-subtitle">Fill in your delivery details</p>

    <form id="addressForm" class="address-form">

      <input type="text" id="fullName" placeholder="Full Name" required />
      <input type="text" id="phone" placeholder="Phone Number" required />

      <input type="text" id="line1" placeholder="House / Flat" required />
      <input type="text" id="street" placeholder="Street / Area" required />

      <input type="text" id="city" placeholder="City" required />
      <input type="text" id="state" placeholder="State" required />

      <input type="text" id="pincode" placeholder="Pincode" required />

      <select id="label">
        <option value="Home">Home</option>
        <option value="Work">Work</option>
        <option value="Other">Other</option>
      </select>

      <label class="checkbox-row">
        <input type="checkbox" id="isDefault" />
        Set as default address
      </label>

      <div class="form-actions">
        <a href="/user/profile" class="cancel-btn">Cancel</a>
        <button type="submit" id="submitBtn">Save Address</button>
      </div>

    </form>

  </div>

  <script src="/js/user.js"></script>
</body>
</html>