<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify OTP</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="login-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="otp-page">
    <div class="otp-card">

      <a href="/signup" class="otp-close">&times;</a>

      <div class="otp-icon">🔒</div>

      <h2>Enter Verification Code</h2>

      <p class="otp-subtitle">
        We’ve sent a verification code to
        <span id="otpEmail">your email</span>
      </p>

      <form id="otpForm">
        <input
          type="text"
          id="otp"
          maxlength="6"
          placeholder="Enter OTP"
          required
        />
        <p id="otpMessage" class="text-danger mt-2"></p>

        <button type="submit" class="login-btn">
          Verify Code
        </button>
      </form>

      <div class="otp-footer">
        <p>Didn't receive the code?</p>
        <p id="timerDisplay" class="otp-timer"></p>
        <button id="resendOtpBtn" type="button" class="otp-resend">
          Resend Code
        </button>
      </div>

    </div>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>