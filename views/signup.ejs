<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account</title>
  <link rel="stylesheet" href="/css/style.css">
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="signup-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="signup-wrapper">
    <div class="signup-brand">Alder & Ash.</div>

    <div class="signup-card">
      <div class="signup-icon">✓</div>

      <h2>Create Account</h2>
      <p class="signup-subtitle">Sign up to get started</p>

      <form id="signupForm" class="signup-form">

        <div class="signup-row">
          <div class="signup-field">
            <input
              type="text"
              id="firstName"
              name="firstName"
              placeholder="First name"
              
            >
            <small class="input-error" id="firstNameError"></small>
          </div>

          <div class="signup-field">
            <input
              type="text"
              id="lastName"
              name="lastName"
              placeholder="Last name"
            >
            <small class="input-error" id="lastNameError"></small>
          </div>
        </div>

        <div class="signup-field">
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            
          >
          <small class="input-error" id="emailError"></small>
        </div>

        <div class="signup-field">
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="Enter your phone number"
            
          >
          <small class="input-error" id="phoneError"></small>
        </div>

        <div class="signup-field">

          <div class="password-box">
        
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Create password"
            >
        
            <span
              id="toggleSignupPassword"
              class="eye-icon"
            >
              <>
            </span>
        
          </div>
        
          <small class="input-error" id="passwordError"></small>
        
        </div>
        <div class="signup-field">

          <div class="password-box">
        
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Confirm password"
            >
        
            <span
              id="toggleConfirmPassword"
              class="eye-icon"
            >
              <>
            </span>
        
          </div>
        
          <small
            class="input-error"
            id="confirmPasswordError"
          ></small>
        
        </div>

        <div id="otpGroup" style="display:none;">
          <div class="signup-field">
            <input
              type="text"
              id="otp"
              name="otp"
              maxlength="6"
              placeholder="Enter OTP"
            >
            <small class="input-error" id="otpError"></small>
          </div>

          <button
            type="button"
            id="resendOtpBtn"
            class="signup-alt-btn"
            style="display:none;"
          >
            Resend OTP
          </button>

          <div id="timerDisplay" class="timer"></div>
        </div>

        <button type="submit" id="submitBtn" class="signup-btn">
          Send OTP
        </button>

        <div class="signup-divider">Or continue with</div>

        <a href="/auth/google" class="google-btn">
          Sign up with Google
        </a>

        <p class="signup-footer">
          Already have an account?
          <a href="/login">Login</a>
        </p>

      </form>
    </div>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>