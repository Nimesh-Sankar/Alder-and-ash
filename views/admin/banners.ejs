<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Banner Management</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
  >
  <style>
    /* Banner card action buttons */
    .banner-actions {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }
  
    .banner-actions button {
      height: 42px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s ease;
    }
  
    .banner-edit-btn {
      flex: 1;
      background: #111;
      color: #fff;
      border: 1px solid #111;
    }
  
    .banner-edit-btn:hover {
      background: #2b2b2b;
      border-color: #2b2b2b;
    }
  
    .banner-toggle-btn {
      min-width: 110px;
      background: #fff;
      color: #111;
      border: 1px solid #d6d6d6;
    }
  
    .banner-toggle-btn:hover {
      background: #f5f5f5;
      border-color: #bcbcbc;
    }
  
    .banner-toggle-btn.activate {
      color: #198754;
      border-color: #b8dfca;
      background: #f2fbf6;
    }
  
    .banner-toggle-btn.activate:hover {
      background: #e5f6ed;
    }
  
    .banner-delete-btn {
      min-width: 85px;
      background: #fff;
      color: #dc3545;
      border: 1px solid #f0b8bd;
    }
  
    .banner-delete-btn:hover {
      background: #dc3545;
      color: #fff;
      border-color: #dc3545;
    }
  
    .banner-actions button:active {
      transform: scale(0.98);
    }
  
    @media (max-width: 576px) {
      .banner-actions {
        flex-wrap: wrap;
      }
  
      .banner-edit-btn {
        flex-basis: 100%;
      }
  
      .banner-toggle-btn,
      .banner-delete-btn {
        flex: 1;
      }
    }
  </style>

</head>

<body class="admin-page">

  <div
    id="alertBox"
    class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded px-4 py-3"
    role="alert"
    style="z-index: 9999;"
  ></div>


  <div class="admin-layout">

    <%- include("../partials/admin-sidebar", {
      activePage: "banners"
    }) %>


    <main class="admin-main">

      <div class="admin-topbar">

        <div class="admin-user-box">

          <div class="admin-profile">
            Welcome Admin
          </div>

        </div>

      </div>


      <section>

        <h1 class="section-title">
          Banner Management
        </h1>

        <p class="text-muted">
          Manage banners displayed on the home page.
        </p>


        <div class="card p-4 mt-4 mb-4">

          <h4
            class="mb-3"
            id="bannerFormTitle"
          >
            Add Banner
          </h4>


          <form
            id="bannerForm"
            enctype="multipart/form-data"
          >

            <div class="mb-3">

              <label class="form-label">
                Banner Title
              </label>

              <input
                type="text"
                name="title"
                class="form-control"
                placeholder="Enter banner title"
                required
              >

            </div>


            <div class="mb-3">

              <label class="form-label">
                Subtitle
              </label>

              <input
                type="text"
                name="subtitle"
                class="form-control"
                placeholder="Enter banner subtitle"
              >

            </div>


            <div class="row">

              <div class="col-md-6 mb-3">

                <label class="form-label">
                  Button Text
                </label>

                <input
                  type="text"
                  name="buttonText"
                  class="form-control"
                  placeholder="Explore Now"
                >

              </div>

            </div>


            <div class="mb-3">

              <label class="form-label">
                Banner Image
              </label>

              <input
                type="file"
                name="image"
                id="bannerImageInput"
                class="form-control"
                accept="image/*"
                required
              >


              <div
                id="bannerCropContainer"
                style="display: none; margin-top: 20px;"
              >

                <img
                  id="bannerCropImage"
                  style="max-width: 100%;"
                  alt="Crop preview"
                >


                <button
                  type="button"
                  id="cropBannerBtn"
                  class="btn btn-dark mt-3"
                >
                  Crop Image
                </button>

              </div>


              <small
                class="text-muted d-block mt-2"
                id="imageHelp"
              >
                Recommended image size: 1600 × 700 px
              </small>

            </div>


            <div class="d-flex gap-2">

              <button
                type="submit"
                id="uploadBannerBtn"
                class="btn btn-dark"
              >
                Upload Banner
              </button>


              <button
                type="button"
                id="cancelEditBtn"
                class="btn btn-secondary"
                style="display: none;"
              >
                Cancel Edit
              </button>

            </div>

          </form>

        </div>


        <div class="card p-4">

          <div
            class="d-flex justify-content-between align-items-center mb-3"
          >

            <h4 class="m-0">
              Existing Banners
            </h4>

          </div>


          <div
            id="bannerList"
            class="row g-4"
          >

            <div class="col-12">

              <p class="text-muted">
                Loading banners...
              </p>

            </div>

          </div>

        </div>

      </section>

    </main>

  </div>


  <div
    id="bannerConfirmModal"
    class="position-fixed top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center"
    style="background: rgba(0,0,0,0.45); z-index: 10000;"
  >

    <div
      class="bg-white p-4 rounded shadow"
      style="width: 360px;"
    >

      <h5 class="mb-3">
        Delete Banner
      </h5>

      <p class="text-muted">
        Are you sure you want to delete this banner?
      </p>

      <div class="d-flex justify-content-end gap-2 mt-4">

        <button
          type="button"
          id="cancelBannerDelete"
          class="btn btn-secondary"
        >
          Cancel
        </button>

        <button
          type="button"
          id="confirmBannerDelete"
          class="btn btn-danger"
        >
          Delete
        </button>

      </div>

    </div>

  </div>


  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>


  <script>

    let bannerCropper = null;
    let croppedBannerBlob = null;


    const bannerImageInput =
      document.getElementById(
        "bannerImageInput"
      );

    const bannerCropContainer =
      document.getElementById(
        "bannerCropContainer"
      );

    const bannerCropImage =
      document.getElementById(
        "bannerCropImage"
      );

    const cropBannerBtn =
      document.getElementById(
        "cropBannerBtn"
      );


    function showAlert(
      message,
      type = "success"
    ) {

      const alertBox =
        document.getElementById(
          "alertBox"
        );

      if (!alertBox) {
        return;
      }

      alertBox.className =
        `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded px-4 py-3`;

      alertBox.textContent =
        message;

      alertBox.classList.remove(
        "d-none"
      );

      setTimeout(() => {

        alertBox.classList.add(
          "d-none"
        );

      }, 3000);
    }


    async function loadBanners() {

      try {

        const response =
          await fetch(
            "/admin/banners"
          );

        const data =
          await response.json();

        const list =
          document.getElementById(
            "bannerList"
          );

        list.innerHTML = "";


        if (
          !response.ok ||
          !data.success
        ) {

          list.innerHTML = `
            <div class="col-12">
              <p class="text-danger">
                Unable to load banners.
              </p>
            </div>
          `;

          return;
        }


        if (
          !data.banners ||
          data.banners.length === 0
        ) {

          list.innerHTML = `
            <div class="col-12">
              <p class="text-muted">
                No banners added yet.
              </p>
            </div>
          `;

          return;
        }


        data.banners.forEach(
          banner => {

            const column =
              document.createElement(
                "div"
              );

            column.className =
              "col-md-6";


            const card =
              document.createElement(
                "div"
              );

            card.className =
              "card h-100 p-3";


            const image =
              document.createElement(
                "img"
              );

            image.src =
              banner.image;

            image.alt =
              banner.title ||
              "Banner";

            image.style.width =
              "100%";

            image.style.height =
              "200px";

            image.style.objectFit =
              "cover";

            image.style.borderRadius =
              "8px";


            const title =
              document.createElement(
                "h5"
              );

            title.className =
              "mt-3";

            title.textContent =
              banner.title;


            const subtitle =
              document.createElement(
                "p"
              );

            subtitle.className =
              "text-muted";

            subtitle.textContent =
              banner.subtitle ||
              "No subtitle";


            const status =
              document.createElement(
                "span"
              );

            status.className =
              banner.isActive
                ? "badge bg-success mb-3"
                : "badge bg-secondary mb-3";

            status.textContent =
              banner.isActive
                ? "Active"
                : "Inactive";

            status.style.width =
              "fit-content";


            const actions =
              document.createElement(
                "div"
              );

              actions.className =
              "banner-actions";


            const editButton =
              document.createElement(
                "button"
              );

              editButton.className =
              "banner-edit-btn";

            editButton.textContent =
              "Edit";

            editButton.addEventListener(
              "click",
              () => {

                editBanner(
                  banner
                );

              }
            );


            const toggleButton =
              document.createElement(
                "button"
              );

              toggleButton.className =
  banner.isActive
    ? "banner-toggle-btn"
    : "banner-toggle-btn activate";

            toggleButton.textContent =
              banner.isActive
                ? "Deactivate"
                : "Activate";

            toggleButton.addEventListener(
              "click",
              () => {

                toggleBanner(
                  banner._id
                );

              }
            );


            const deleteButton =
              document.createElement(
                "button"
              );

              deleteButton.className =
              "banner-delete-btn";

            deleteButton.textContent =
              "Delete";

            deleteButton.addEventListener(
              "click",
              () => {

                deleteBanner(
                  banner._id
                );

              }
            );


            actions.appendChild(
              editButton
            );

            actions.appendChild(
              toggleButton
            );

            actions.appendChild(
              deleteButton
            );


            card.appendChild(
              image
            );

            card.appendChild(
              title
            );

            card.appendChild(
              subtitle
            );

            card.appendChild(
              status
            );

            card.appendChild(
              actions
            );


            column.appendChild(
              card
            );

            list.appendChild(
              column
            );

          }
        );

      } catch (error) {

        console.log(
          "LOAD BANNERS ERROR:",
          error
        );

        showAlert(
          "Unable to load banners",
          "danger"
        );
      }
    }


    document
      .getElementById(
        "bannerForm"
      )
      .addEventListener(
        "submit",
        async event => {

          event.preventDefault();


          const button =
            document.getElementById(
              "uploadBannerBtn"
            );

          const editId =
            event.target.dataset.editId;


          const imageFile =
            event.target.elements[
              "image"
            ].files[0];


          if (
            !editId &&
            imageFile &&
            !croppedBannerBlob
          ) {

            showAlert(
              "Please crop the banner image before uploading.",
              "danger"
            );

            return;
          }


          if (
            editId &&
            imageFile &&
            !croppedBannerBlob
          ) {

            showAlert(
              "Please crop the new banner image before updating.",
              "danger"
            );

            return;
          }


          button.disabled =
            true;

          button.textContent =
            editId
              ? "Updating..."
              : "Uploading...";


          try {

            const formData =
              new FormData(
                event.target
              );


            if (croppedBannerBlob) {

              formData.set(
                "image",
                croppedBannerBlob,
                "banner.jpg"
              );

            }


            const url =
              editId
                ? `/admin/banners/${editId}`
                : "/admin/banners";


            const method =
              editId
                ? "PATCH"
                : "POST";


            const response =
              await fetch(
                url,
                {
                  method,
                  body: formData
                }
              );


            const data =
              await response.json();


            showAlert(
              data.message ||
              "Banner saved",
              response.ok
                ? "success"
                : "danger"
            );


            if (response.ok) {

              resetBannerForm();

              await loadBanners();
            }

          } catch (error) {

            console.log(
              "BANNER SAVE ERROR:",
              error
            );

            showAlert(
              "Unable to save banner",
              "danger"
            );

          } finally {

            button.disabled =
              false;

            button.textContent =
              editId
                ? "Update Banner"
                : "Upload Banner";
          }

        }
      );


    async function toggleBanner(id) {

      try {

        const response =
          await fetch(
            `/admin/banners/${id}/status`,
            {
              method: "PATCH"
            }
          );

        const data =
          await response.json();


        showAlert(
          data.message ||
          "Banner status updated",
          response.ok
            ? "success"
            : "danger"
        );


        if (response.ok) {

          await loadBanners();

        }

      } catch (error) {

        console.log(
          "TOGGLE BANNER ERROR:",
          error
        );

        showAlert(
          "Unable to update banner",
          "danger"
        );
      }
    }


    function confirmBannerDelete() {

      return new Promise(
        resolve => {

          const modal =
            document.getElementById(
              "bannerConfirmModal"
            );

          const cancelButton =
            document.getElementById(
              "cancelBannerDelete"
            );

          const confirmButton =
            document.getElementById(
              "confirmBannerDelete"
            );


          function closeModal(
            result
          ) {

            modal.classList.add(
              "d-none"
            );

            modal.classList.remove(
              "d-flex"
            );

            cancelButton.onclick =
              null;

            confirmButton.onclick =
              null;

            modal.onclick =
              null;

            resolve(
              result
            );
          }


          cancelButton.onclick =
            () =>
              closeModal(
                false
              );


          confirmButton.onclick =
            () =>
              closeModal(
                true
              );


          modal.onclick =
            event => {

              if (
                event.target === modal
              ) {

                closeModal(
                  false
                );

              }

            };


          modal.classList.remove(
            "d-none"
          );

          modal.classList.add(
            "d-flex"
          );
        }
      );
    }


    async function deleteBanner(id) {

      const confirmed =
        await confirmBannerDelete();


      if (!confirmed) {
        return;
      }


      try {

        const response =
          await fetch(
            `/admin/banners/${id}`,
            {
              method: "DELETE"
            }
          );

        const data =
          await response.json();


        showAlert(
          data.message ||
          "Banner deleted",
          response.ok
            ? "success"
            : "danger"
        );


        if (response.ok) {

          await loadBanners();

        }

      } catch (error) {

        console.log(
          "DELETE BANNER ERROR:",
          error
        );

        showAlert(
          "Unable to delete banner",
          "danger"
        );
      }
    }


    function editBanner(
      banner
    ) {

      const form =
        document.getElementById(
          "bannerForm"
        );


      form.dataset.editId =
        banner._id;


      form.elements[
        "title"
      ].value =
        banner.title ||
        "";


      form.elements[
        "subtitle"
      ].value =
        banner.subtitle ||
        "";


      form.elements[
        "buttonText"
      ].value =
        banner.buttonText ||
        "";


      form.elements[
        "image"
      ].required =
        false;


      document.getElementById(
        "uploadBannerBtn"
      ).textContent =
        "Update Banner";


      document.getElementById(
        "bannerFormTitle"
      ).textContent =
        "Edit Banner";


      document.getElementById(
        "cancelEditBtn"
      ).style.display =
        "inline-block";


      document.getElementById(
        "imageHelp"
      ).textContent =
        "Leave image empty to keep the current image. New images must be cropped to 1600 × 700.";


      form.scrollIntoView({
        behavior: "smooth"
      });
    }


    function resetBannerForm() {

      const form =
        document.getElementById(
          "bannerForm"
        );


      form.reset();


      delete form.dataset.editId;


      form.elements[
        "image"
      ].required =
        true;


      document.getElementById(
        "uploadBannerBtn"
      ).textContent =
        "Upload Banner";


      document.getElementById(
        "bannerFormTitle"
      ).textContent =
        "Add Banner";


      document.getElementById(
        "cancelEditBtn"
      ).style.display =
        "none";


      document.getElementById(
        "imageHelp"
      ).textContent =
        "Recommended image size: 1600 × 700 px";


      croppedBannerBlob =
        null;


      if (bannerCropper) {

        bannerCropper.destroy();

        bannerCropper =
          null;

      }


      bannerCropContainer.style.display =
        "none";


      bannerCropImage.removeAttribute(
        "src"
      );


      cropBannerBtn.textContent =
        "Crop Image";
    }


    document
      .getElementById(
        "cancelEditBtn"
      )
      .addEventListener(
        "click",
        resetBannerForm
      );


    bannerImageInput.addEventListener(
      "change",
      event => {

        const file =
          event.target.files[0];


        if (!file) {
          return;
        }


        const allowedTypes = [
          "image/jpeg",
          "image/png",
          "image/webp"
        ];


        if (
          !allowedTypes.includes(
            file.type
          )
        ) {

          showAlert(
            "Please select a JPG, PNG or WebP image.",
            "danger"
          );

          bannerImageInput.value =
            "";

          return;
        }


        croppedBannerBlob =
          null;


        cropBannerBtn.textContent =
          "Crop Image";


        if (bannerCropper) {

          bannerCropper.destroy();

          bannerCropper =
            null;

        }


        const imageUrl =
          URL.createObjectURL(
            file
          );


        bannerCropImage.src =
          imageUrl;


        bannerCropContainer.style.display =
          "block";


        bannerCropImage.onload =
          () => {

            bannerCropper =
              new Cropper(
                bannerCropImage,
                {
                  aspectRatio:
                    1600 / 700,

                  viewMode: 1,

                  dragMode:
                    "move",

                  autoCropArea:
                    1,

                  responsive:
                    true,

                  background:
                    false
                }
              );

          };

      }
    );


    cropBannerBtn.addEventListener(
      "click",
      () => {

        if (!bannerCropper) {

          showAlert(
            "Please select an image first.",
            "danger"
          );

          return;
        }


        const canvas =
          bannerCropper
            .getCroppedCanvas({
              width: 1600,
              height: 700,
              imageSmoothingEnabled:
                true,
              imageSmoothingQuality:
                "high"
            });


        canvas.toBlob(
          blob => {

            if (!blob) {

              showAlert(
                "Unable to crop image",
                "danger"
              );

              return;
            }


            croppedBannerBlob =
              blob;


            bannerCropper.destroy();

            bannerCropper =
              null;


            bannerCropImage.src =
              canvas.toDataURL(
                "image/jpeg"
              );


            cropBannerBtn.textContent =
              "Image Cropped ✓";


            showAlert(
              "Banner image cropped successfully",
              "success"
            );

          },
          "image/jpeg",
          0.9
        );

      }
    );


    loadBanners();

  </script>

</body>

</html>