<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="admin-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="admin-layout">

    
 

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li
      id="dashboardMenu"
      class="active"
      onclick="showSection('dashboardSection')"
    >
      Dashboard
    </li>

    <li
      id="usersMenu"
      onclick="showSection('usersSection')"
    >
      Users
    </li>

    <li onclick="window.location.href='/admin/products-page'">
      Products
    </li>

    <li onclick="window.location.href='/admin/brands-page'">
      Brands
    </li>

    <li onclick="window.location.href='/admin/category'">
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li onclick="window.location.href='/admin/coupons-page'">
      Coupons
    </li>

    <li onclick="window.location.href='/admin/banners-page'">
      Banners
    </li>

    <li onclick="window.location.href='/admin/reports'">
      Reports
    </li>

  </ul>

</aside>

    
    <main class="admin-main">

      
      <div class="admin-topbar">
        
      
        <div class="admin-user-box">
          <div class="admin-profile">Welcome Admin</div>
      
          <button onclick="adminLogout()" class="logout-btn">
            Logout
          </button>
        </div>
      </div>

      
      <section id="dashboardSection">
        <h1 class="section-title">Dashboard</h1>

        <div class="dashboard-cards">

          <div class="dashboard-card">
            <h4>Orders</h4>
            <p id="dashboardOrders">0</p>
          </div>
        
          <div class="dashboard-card">
            <h4>Revenue</h4>
            <p id="dashboardRevenue">₹0</p>
          </div>
        
          <div class="dashboard-card">
            <h4>Users</h4>
            <p id="dashboardUsers">0</p>
          </div>
        
          <div class="dashboard-card">
            <h4>Products</h4>
            <p id="dashboardProducts">0</p>
          </div>
        
        </div>
        <div class="dashboard-analytics">

          <div class="dashboard-chart-row">
        
            <!-- SALES CHART -->
            <div class="dashboard-panel">
              <div class="dashboard-panel-header">
                <h3>Sales Over Time</h3>
                <span>Last 7 days</span>
              </div>
        
              <div class="chart-container">
                <canvas id="salesChart"></canvas>
              </div>
            </div>
        
        
            <!-- TOP BRANDS -->
            <div class="dashboard-panel">
              <div class="dashboard-panel-header">
                <h3>Top Selling Brands</h3>
              </div>
        
              <div class="chart-container">
                <canvas id="brandsChart"></canvas>
              </div>
            </div>
        
          </div>
        
        
          <div class="dashboard-bottom-row">
        
            <!-- RECENT ORDERS -->
            <div class="dashboard-panel">
        
              <div class="dashboard-panel-header">
                <h3>Recent Orders</h3>
        
                <a href="/api/orders/admin/orders">
                  View All Orders
                </a>
              </div>
        
              <div class="table-responsive">
        
                <table class="table align-middle">
        
                  <thead>
                    <tr>
                      <th>Order</th>
                      <th>Customer</th>
                      <th>Amount</th>
                      <th>Status</th>
                    </tr>
                  </thead>
        
                  <tbody id="recentOrdersBody">
                    <tr>
                      <td colspan="4">
                        Loading...
                      </td>
                    </tr>
                  </tbody>
        
                </table>
        
              </div>
        
            </div>
        
        
            <!-- LOW STOCK -->
            <div class="dashboard-panel">
        
              <div class="dashboard-panel-header">
                <h3>Low Stock Products</h3>
              </div>
        
              <div
                id="lowStockProducts"
                class="low-stock-list"
              >
                Loading...
              </div>
        
            </div>
        
          </div>
        
        </div>
      </section>

      <!-- Users Section -->
      <section id="usersSection" style="display:none;">
        <h1 class="section-title">Users</h1>

        <div class="users-toolbar">
          <input type="text" id="searchInput" placeholder="Search users..." />
          <button onclick="loadUsers()">Search</button>
          <button onclick="clearSearch()">Clear</button>

          



        </div>

        <div class="table-wrapper">
          <table class="users-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Action</th>
                <th>orders</th>
              </tr>
            </thead>
            <tbody id="usersTableBody"></tbody>
          </table>
        </div>
        <div class="pagination" id="pagination"></div>
      </section>

    </main>

  </div>
  <script>
    const admin = localStorage.getItem("admin");
  
    if (!admin) {
      window.location.href = "/admin/login";
    }
  </script>
  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/admin.js"></script>
  <script>

    let salesChart = null;
    let brandsChart = null;
    
    
    async function loadDashboardStats() {
    
      try {
    
        const response =
          await fetch(
            "/admin/dashboard-stats"
          );
    
        const result =
          await response.json();
    
    
        if (
          !response.ok ||
          !result.success
        ) {
    
          throw new Error(
            result.message ||
            "Unable to load dashboard"
          );
        }
    
    
        const data =
          result.data;
    
    
        // ======================
        // CARDS
        // ======================
    
        document.getElementById(
          "dashboardOrders"
        ).textContent =
          data.totalOrders;
    
    
        document.getElementById(
          "dashboardUsers"
        ).textContent =
          data.totalUsers;
    
    
        document.getElementById(
          "dashboardProducts"
        ).textContent =
          data.totalProducts;
    
    
        document.getElementById(
          "dashboardRevenue"
        ).textContent =
          "₹" +
          Number(
            data.totalRevenue || 0
          ).toLocaleString("en-IN");
    
    
    
        // ======================
        // SALES CHART
        // ======================
    
        const salesLabels =
          data.salesLast7Days.map(
            item => item.label
          );
    
    
        const salesValues =
          data.salesLast7Days.map(
            item => item.revenue
          );
    
    
        const salesCanvas =
          document.getElementById(
            "salesChart"
          );
    
    
        if (salesChart) {
          salesChart.destroy();
        }
    
    
        salesChart =
          new Chart(
            salesCanvas,
            {
    
              type: "line",
    
              data: {
    
                labels:
                  salesLabels,
    
                datasets: [
                  {
    
                    label:
                      "Revenue",
    
                    data:
                      salesValues,
    
                    borderWidth: 2,
    
                    tension: 0.3,
    
                    fill: true
                  }
                ]
              },
    
    
              options: {
    
                responsive: true,
    
                maintainAspectRatio:
                  false,
    
                plugins: {
    
                  legend: {
                    display: false
                  }
                },
    
                scales: {
    
                  y: {
    
                    beginAtZero:
                      true,
    
                    ticks: {
    
                      callback:
                        value =>
                          "₹" +
                          Number(
                            value
                          ).toLocaleString(
                            "en-IN"
                          )
                    }
                  }
                }
              }
            }
          );
    
    
    
        // ======================
        // TOP BRANDS CHART
        // ======================
    
        const brandLabels =
          data.topBrands.map(
            item =>
              item.brandName
          );
    
    
        const brandValues =
          data.topBrands.map(
            item =>
              item.quantitySold
          );
    
    
        const brandsCanvas =
          document.getElementById(
            "brandsChart"
          );
    
    
        if (brandsChart) {
          brandsChart.destroy();
        }
    
    
        brandsChart =
          new Chart(
            brandsCanvas,
            {
    
              type: "doughnut",
    
              data: {
    
                labels:
                  brandLabels,
    
                datasets: [
                  {
    
                    data:
                      brandValues
                  }
                ]
              },
    
    
              options: {
    
                responsive:
                  true,
    
                maintainAspectRatio:
                  false,
    
                plugins: {
    
                  legend: {
    
                    position:
                      "bottom"
                  }
                }
              }
            }
          );
    
    
    
        // ======================
        // RECENT ORDERS
        // ======================
    
        const recentOrdersBody =
          document.getElementById(
            "recentOrdersBody"
          );
    
    
        if (
          !data.recentOrders ||
          data.recentOrders.length === 0
        ) {
    
          recentOrdersBody.innerHTML = `
    
            <tr>
    
              <td colspan="4">
                No recent orders
              </td>
    
            </tr>
    
          `;
    
        } else {
    
          recentOrdersBody.innerHTML =
    
            data.recentOrders
              .map(order => {
    
    
                const customerName =
    
                  order.user
    
                    ? `${
                        order.user
                          .firstName || ""
                      } ${
                        order.user
                          .lastName || ""
                      }`
    
                    : "Unknown User";
    
    
                return `
    
                  <tr>
    
                    <td>
                      ${order.orderId}
                    </td>
    
    
                    <td>
                      ${customerName}
                    </td>
    
    
                    <td>
    
                      ₹${Number(
                        order.grandTotal || 0
                      ).toLocaleString(
                        "en-IN"
                      )}
    
                    </td>
    
    
                    <td>
    
                      <span class="
                        dashboard-status
                        status-${order.status.toLowerCase()}
                      ">
    
                        ${order.status}
    
                      </span>
    
                    </td>
    
                  </tr>
    
                `;
    
              })
              .join("");
        }
    
    
    
        // ======================
        // LOW STOCK
        // ======================
    
        const lowStockContainer =
          document.getElementById(
            "lowStockProducts"
          );
    
    
        if (
          !data.lowStockProducts ||
          data.lowStockProducts
            .length === 0
        ) {
    
          lowStockContainer.innerHTML = `
    
            <p class="no-low-stock">
              No low stock products
            </p>
    
          `;
    
        } else {
    
          lowStockContainer.innerHTML =
    
            data.lowStockProducts
              .map(product => {
    
                return `
    
                  <div class="low-stock-item">
    
                    <div>
    
                      <strong>
                        ${product.productName}
                      </strong>
    
                      <p>
    
                        Only
                        ${product.lowestStock}
                        left in stock
    
                      </p>
    
                    </div>
    
    
                    <span class="stock-badge">
    
                      ${product.lowestStock}
    
                    </span>
    
                  </div>
    
                `;
    
              })
              .join("");
        }
    
    
      } catch (error) {
    
        console.log(
          "DASHBOARD LOAD ERROR:",
          error
        );
      }
    }
    
    
    loadDashboardStats();
    
    </script>
    <div id="userConfirmModal" class="user-confirm-modal">

      <div class="user-confirm-box">
    
        <div class="confirm-icon">!</div>
    
        <h3>Confirm Action</h3>
    
        <p id="userConfirmText">
          Are you sure?
        </p>
    
        <div class="user-confirm-actions">
    
          <button
            type="button"
            id="userConfirmCancel"
            class="confirm-cancel-btn"
          >
            Cancel
          </button>
    
          <button
            type="button"
            id="userConfirmButton"
            class="confirm-action-btn"
          >
            Confirm
          </button>
    
        </div>
    
      </div>
    
    </div>
  </body>
  </html>