<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>
</head>
<body class="admin-page">
  <div
  id="alertBox"
  class="alert d-none position-fixed top-0 end-0 m-3"
  role="alert"
  style="z-index: 9999;"
></div>

  <div class="admin-layout">

    
    <!-- SIDEBAR -->
<!-- DASHBOARD SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li class="active">
      Dashboard
    </li>
    <li onclick="showSection('usersSection')">
      Users
    </li>

    <li
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li onclick="window.location.href='/admin/coupons-page'">
      Coupons
  </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>

    
    <main class="admin-main">

      
      <div class="admin-topbar">
        
      
        <div class="admin-user-box">
          <div class="admin-profile">Welcome Admin</div>
      
          <button onclick="adminLogout()" class="logout-btn">
            Logout
          </button>
        </div>
      </div>

      
      <section id="dashboardSection">
        <h1 class="section-title">Dashboard</h1>

        <div class="dashboard-cards">
          <div class="dashboard-card">
            <h4>Product Orders</h4>
            <p>1,456</p>
          </div>

          <div class="dashboard-card">
            <h4>Revenue</h4>
            <p>$892,340</p>
          </div>

          <div class="dashboard-card">
            <h4>Users</h4>
            <p>132</p>
          </div>
        </div>

        <div class="dashboard-placeholder">
          Dashboard
        </div>
      </section>

      <!-- Users Section -->
      <section id="usersSection" style="display:none;">
        <h1 class="section-title">Users</h1>

        <div class="users-toolbar">
          <input type="text" id="searchInput" placeholder="Search users..." />
          <button onclick="loadUsers()">Search</button>
          <button onclick="clearSearch()">Clear</button>

          



        </div>

        <div class="table-wrapper">
          <table class="users-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="usersTableBody"></tbody>
          </table>
        </div>
        <div class="pagination" id="pagination"></div>
      </section>

    </main>

  </div>
  <script>
    const admin = localStorage.getItem("admin");
  
    if (!admin) {
      window.location.href = "/admin/login";
    }
  </script>
  
    <script src="/js/admin.js"></script>
  </body>
  </html>