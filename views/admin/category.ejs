<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Category Management</title>

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="admin-container">

    <!-- SIDEBAR -->
<!-- CATEGORY SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li onclick="window.location.href='/admin'">
      Dashboard
    </li>
    
    <li onclick="window.location.href='/admin'">
      Users
    </li>

    <li
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li onclick="window.location.href='/admin/coupons-page'">
      Coupons
  </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>

</aside>    
    <main class="admin-main">

      <div class="category-header">
        <h1>Product Categories</h1>
        
        <button
  onclick="window.location.href='/admin/add-category'"
>
  Add Category
</button>
      </div>
      <div class="category-topbar">

        <input
          type="text"
          id="categorySearchInput"
          placeholder="Search category..."
        />
      
        <button onclick="loadCategories()">
          Search
        </button>
      
        <button onclick="clearCategorySearch()">
          Clear
        </button>
      
      </div>

      
  
<div id="categoryContainer" class="category-grid">

</div>

<div id="categoryPagination"></div>


 
  <script src="/js/admin.js"></script>
  <div
  id="confirmModal"
  class="confirm-modal"
  >
  
  <div class="confirm-box">
  
  <h3>
  Confirm Delete
  </h3>
  
  <p id="confirmText">
  Are you sure?
  </p>
  
  <div>
  
  <button
  id="cancelDelete"
  >
  Cancel
  </button>
  
  <button
  id="confirmDelete" >
  Delete
  </button>
  
  </div>
  
  </div>
  
  </div>
</body>
</html>