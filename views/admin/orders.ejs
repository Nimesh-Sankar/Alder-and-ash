<!DOCTYPE html>

<html>
<head>

    <title>Admin Orders</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin-orders.css">
</head>

<body>
    <div class="admin-container">

        <%- include("../partials/admin-sidebar", {
            activePage: "orders"
          }) %>

        <main class="admin-main">

            <h1>Orders Management</h1>

            <div class="card-container">

                <div class="card">
                    <h3>Total Orders</h3>
                    <p><%= totalOrders %></p>
                </div>

                <div class="card">
                    <h3>Completed</h3>
                    <p><%= deliveredCount %></p>
                </div>

                <div class="card">
                    <h3>Pending</h3>
                    <p><%= placedCount %></p>
                </div>

                <div class="card">
                    <h3>Revenue</h3>
                    <p>₹<%= revenue %></p>
                </div>

            </div>

            <div class="filter-box">

                <form
                    class="filter-form"
                    method="GET"
                    action="/api/orders/admin/orders"
                >

                    <input
                        type="text"
                        name="search"
                        placeholder="Search Order ID"
                        value="<%= search || '' %>"
                    >

                    <select name="status">

                        <option value="">All Status</option>

                        <option
                            value="PLACED"
                            <%= status==="PLACED" ? "selected" : "" %>>
                            Placed
                        </option>

                        <option
                            value="PROCESSING"
                            <%= status==="PROCESSING" ? "selected" : "" %>>
                            Processing
                        </option>

                        <option
                            value="SHIPPED"
                            <%= status==="SHIPPED" ? "selected" : "" %>>
                            Shipped
                        </option>

                        <option
                            value="DELIVERED"
                            <%= status==="DELIVERED" ? "selected" : "" %>>
                            Delivered
                        </option>

                        <option
                            value="RETURN_REQUESTED"
                            <%= status==="RETURN_REQUESTED" ? "selected" : "" %>>
                            Return Requested
                        </option>

                        <option
                            value="RETURNED"
                            <%= status==="RETURNED" ? "selected" : "" %>>
                            Returned
                        </option>

                        <option
                            value="CANCELLED"
                            <%= status==="CANCELLED" ? "selected" : "" %>>
                            Cancelled
                        </option>

                    </select>

                    <select name="sort">

                        <option
                            value="latest"
                            <%= sort==="latest" ? "selected" : "" %>>
                            Latest First
                        </option>

                        <option
                            value="oldest"
                            <%= sort==="oldest" ? "selected" : "" %>>
                            Oldest First
                        </option>

                    </select>

                    <button type="submit">
                        Apply
                    </button>

                    <a href="/api/orders/admin/orders">
                        Clear
                    </a>

                </form>

            </div>

            <table border="1">

                <tr>

                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>

                </tr>

                <% orders.forEach(order=>{ %>

                <tr>

                    <td>
                        <%= order.orderId %>
                    </td>

                    <td>

                        <% if(order.user){ %>

                            <%= order.user.firstName %>
                            <%= order.user.lastName %>

                        <% } else { %>

                            Unknown User

                        <% } %>

                    </td>

                    <td>
                        <%= order.items[0]?.product?.productName || "Deleted Product" %>
                    </td>

                    <td>
                        ₹<%= order.grandTotal %>
                    </td>

                    <td>

                        <form
                            action="/api/orders/admin/update-status/<%= order.orderId %>"
                            method="POST"
                        >

                            <select name="status">

                                <option
                                    value="PLACED"
                                    <%= order.status==="PLACED" ? "selected" : "" %>>
                                    PLACED
                                </option>

                                <option
                                    value="PROCESSING"
                                    <%= order.status==="PROCESSING" ? "selected" : "" %>>
                                    PROCESSING
                                </option>

                                <option
                                    value="SHIPPED"
                                    <%= order.status==="SHIPPED" ? "selected" : "" %>>
                                    SHIPPED
                                </option>

                                <option
                                    value="DELIVERED"
                                    <%= order.status==="DELIVERED" ? "selected" : "" %>>
                                    DELIVERED
                                </option>

                                <option
                                    value="RETURN_REQUESTED"
                                    <%= order.status==="RETURN_REQUESTED" ? "selected" : "" %>>
                                    RETURN REQUESTED
                                </option>

                                <option
                                    value="RETURNED"
                                    <%= order.status==="RETURNED" ? "selected" : "" %>>
                                    RETURNED
                                </option>

                                <option
                                    value="CANCELLED"
                                    <%= order.status==="CANCELLED" ? "selected" : "" %>>
                                    CANCELLED
                                </option>

                            </select>

                            <button type="submit">
                                Update
                            </button>

                        </form>

                    </td>

                    <td>
                        <%= order.createdAt.toDateString() %>
                    </td>

                    <td>

                        <a
                            href="/api/orders/admin/details/<%= order.orderId %>"
                        >
                            View Details
                        </a>

                    </td>

                </tr>

                <% }) %>

            </table>

            <div class="pagination">

                <% for(let i = 1; i <= totalPages; i++) { %>

                    <a
                        href="/api/orders/admin/orders?page=<%= i %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>">

                        <%= i %>

                    </a>

                <% } %>

            </div>

        </main>

    </div>

</body>
</html>