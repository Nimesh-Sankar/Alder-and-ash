<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Products</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

</head>

<body>
  <div id="alertBox"
    class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
    role="alert"
    style="z-index: 9999;"></div>

  <div class="admin-container">


<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li onclick="window.location.href='/admin'">
      Dashboard
    </li>
    
    <li onclick="window.location.href='/admin'">
      Users
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li>
      Coupons
    </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>
    <div id="Container"></div>    
    <main class="admin-main">

      <div class="category-header">

        <h1>
          Product Management
        </h1>

        <button
          onclick="window.location.href='/admin/add-product'"
        >
          Add Product
        </button>

      </div>

      <!-- SEARCH -->
      <div class="category-topbar">

        <input type="date"
        id="fromDate">

        <input type="date"
        id="toDate"
        >

        <input
          type="text"
          id="productSearchInput"
          placeholder="Search product..."
        />

        <button onclick="loadProducts()">
          Search
        </button>

        <button onclick="clearProductSearch()">
          Clear
        </button>

      </div>

      <!-- PRODUCTS -->
      <table class="product-table">

        <thead>
          <tr>
              <th>#</th>
              <th>Image</th>
              <th>Product</th>
              <th>Category</th>
              <th>Brand</th>
              <th>Stock</th>
              <th>Price</th>
              <th>Actions</th>
          </tr>
      </thead>
    
        <tbody id="productContainer">
    
        </tbody>
    
    </table>

      <!-- PAGINATION -->
      <div id="productPagination">

      </div>

    </main>

  </div>
      
  
  <script src="/js/admin.js"></script>
  <div
  id="confirmModal"
  class="confirm-modal"
  >
  
  <div class="confirm-box">
  
  <h3>
  Confirm Delete
  </h3>
  
  <p id="confirmText">
  Are you sure?
  </p>
  
  <div>
  
  <button
  id="cancelDelete"
  >
  Cancel
  </button>
  
  <button
  id="confirmDelete"
  >
  Delete
  </button>
  
  </div>
  
  </div>
  
  </div>
</body>
</html>