<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Products</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />

</head>

<body>

  <div class="admin-container">
    <!-- SIDEBAR -->
<!-- PRODUCTS SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li onclick="window.location.href='/admin'">
      Dashboard
    </li>
    
    <li onclick="window.location.href='/admin'">
      Users
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li>
      Orders
    </li>

    <li>
      Coupons
    </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>
    <div id="Container"></div>    
    <main class="admin-main">

      <div class="category-header">

        <h1>
          Product Management
        </h1>

        <button
          onclick="window.location.href='/admin/add-product'"
        >
          Add Product
        </button>

      </div>

      <!-- SEARCH -->
      <div class="category-topbar">

        <input
          type="text"
          id="productSearchInput"
          placeholder="Search product..."
        />

        <button onclick="loadProducts()">
          Search
        </button>

        <button onclick="clearProductSearch()">
          Clear
        </button>

      </div>

      <!-- PRODUCTS -->
      <div
        id="productContainer"
        class="category-grid"
      >

      </div>

      <!-- PAGINATION -->
      <div id="productPagination">

      </div>

    </main>

  </div>
      
  
  <script src="/js/admin.js"></script>

</body>
</html>