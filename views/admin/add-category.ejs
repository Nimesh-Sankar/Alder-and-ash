<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Add Category</title>

  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div id="alertBox"
  class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
  role="alert"
  style="z-index: 9999;"></div>

  <div class="admin-container">

    
   
<!-- SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li
      onclick="window.location.href='/admin'"
    >
      Dashboard
    </li>

    <li
      onclick="window.location.href='/admin'"
    >
      Users
    </li>

    <li
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li>
      Coupons
    </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>


    <!-- MAIN CONTENT -->
    <main class="admin-main">

      <div class="form-container">

        <h1>
          Add Category
        </h1>

        <form id="addCategoryForm">

          <div class="form-group">

            <label>
              Category Name
            </label>

            <input
              type="text"
              id="categoryName"
              placeholder="Enter category name"
              required
            />

          </div>

          <div class="form-group">

            <label>
              Description
            </label>

            <textarea
              id="categoryDescription"
              placeholder="Enter category description"
              required
            ></textarea>

          </div>

          <div class="form-buttons">

            <button
              type="button"
              class="cancel-btn"
              onclick="window.location.href='/admin/category'"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="save-btn"
            >
              Add Category
            </button>

          </div>

        </form>

      </div>

    </main>

  </div>

  <script src="/js/admin.js"></script>

</body>
</html>