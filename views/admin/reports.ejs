<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sales Reports</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/reports.css"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    >
</head>

<body>
    <div
  id="alertBox"
  class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded px-4 py-3"
  role="alert"
  style="z-index: 9999;"
></div>

<div class="admin-container">

    <!-- ================= SIDEBAR ================= -->

    <%- include("../partials/admin-sidebar", {
        activePage: "reports"
      }) %>


    <!-- ================= MAIN ================= -->

    <main class="admin-main">

        <div class="reports-header">

            <div>
                <h1>Sales Reports</h1>

                <p>
                    View and download your sales performance.
                </p>
            </div>

        </div>


        <!-- ================= FILTERS ================= -->

        <section class="report-filter-card">

            <h3>Report Period</h3>

            <div class="report-filters">

                <div class="filter-group">

                    <label for="reportType">
                        Report Type
                    </label>

                    <select id="reportType">

                        <option value="daily">
                            Daily
                        </option>

                        <option value="weekly">
                            Weekly
                        </option>

                        <option value="yearly">
                            Yearly
                        </option>

                        <option value="custom">
                            Custom
                        </option>

                    </select>

                </div>


                <div
                    class="filter-group custom-date"
                    id="customDateGroup"
                >

                    <label for="fromDate">
                        From
                    </label>

                    <input
                        type="date"
                        id="fromDate"
                    >

                </div>


                <div
                    class="filter-group custom-date"
                    id="toDateGroup"
                >

                    <label for="toDate">
                        To
                    </label>

                    <input
                        type="date"
                        id="toDate"
                    >

                </div>


                <div class="filter-actions">

                    <button
                        type="button"
                        id="generateReportBtn"
                    >
                        Generate Report
                    </button>

                </div>

            </div>

        </section>


        <!-- ================= SUMMARY ================= -->

        <section class="report-summary">

            <div class="summary-card">

                <span>
                    Overall Sales Count
                </span>

                <strong id="salesCount">
                    0
                </strong>

            </div>


            <div class="summary-card">

                <span>
                    Gross Sales
                </span>

                <strong id="grossSales">
                    ₹0.00
                </strong>

            </div>


            <div class="summary-card">

                <span>
                    Discount
                </span>

                <strong id="totalDiscount">
                    ₹0.00
                </strong>

            </div>
            <div class="summary-card">

                <span>
                    Refund Amount
                </span>
            
                <strong id="totalRefund">
                    ₹0.00
                </strong>
            
            </div>


            <div class="summary-card">

                <span>
                    Order Amount
                </span>

                <strong id="netSales">
                    ₹0.00
                </strong>

            </div>

        </section>


        <!-- ================= DOWNLOADS ================= -->

        <section class="report-download-card">

            <div>

                <h3>
                    Download Report
                </h3>

                <p>
                    Export the current report as PDF or Excel.
                </p>

            </div>


            <div class="download-buttons">

                <button
                    type="button"
                    id="downloadPdfBtn"
                >
                    Download PDF
                </button>

                <button
                    type="button"
                    id="downloadExcelBtn"
                >
                    Download Excel
                </button>

            </div>

        </section>


        <!-- ================= ORDERS ================= -->

        <section class="report-table-card">

            <div class="table-header">

                <h3>
                    Sales Details
                </h3>

                <span id="reportPeriod">
                    -
                </span>

            </div>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>
                                Order ID
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Subtotal
                            </th>

                            <th>
                                Discount
                            </th>

                            <th>
                                Order Amount
                            </th>
                            <th>
                                Refund
                            </th>
                            
                            <th>
                                Net Amount
                            </th>
                            
                            <th>
                                Payment
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>

                    <tbody id="reportTableBody">

                        <tr>

                            <td
                                colspan="11"
                                class="empty-report"
                            >
                                Generate a report to view sales.
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>


<script>
    function showAlert(message, type = "success") {
  const alertBox =
    document.getElementById("alertBox");

  if (!alertBox) return;

  alertBox.className =
    `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded px-4 py-3`;

  alertBox.textContent = message;

  alertBox.classList.remove("d-none");

  setTimeout(() => {
    alertBox.classList.add("d-none");
  }, 3000);
}

  const reportType = document.getElementById("reportType");
  
  const customDateGroup =
      document.querySelectorAll(".custom-date");
  
  const fromDate =
      document.getElementById("fromDate");
  
  const toDate =
      document.getElementById("toDate");
  
  const generateReportBtn =
      document.getElementById("generateReportBtn");
  
  const downloadPdfBtn =
      document.getElementById("downloadPdfBtn");
  
  const downloadExcelBtn =
      document.getElementById("downloadExcelBtn");
  
  const salesCount =
      document.getElementById("salesCount");
  
  const grossSales =
      document.getElementById("grossSales");
  
  const totalDiscount =
      document.getElementById("totalDiscount");
      const totalRefund =
    document.getElementById("totalRefund");
  
  const netSales =
      document.getElementById("netSales");
  
  const reportTableBody =
      document.getElementById("reportTableBody");
  
  const reportPeriod =
      document.getElementById("reportPeriod");
  
  
  // ==============================
  // FORMAT CURRENCY
  // ==============================
  
  function formatCurrency(value) {
  
      return `₹${Number(value || 0).toFixed(2)}`;
  
  }
  
  
  // ==============================
  // FORMAT DATE
  // ==============================
  
  function formatDate(date) {
  
      if (!date) {
          return "-";
      }
  
      return new Date(date).toLocaleDateString();
  
  }
  
  
  // ==============================
  // SHOW / HIDE CUSTOM DATES
  // ==============================
  
  function updateCustomDates() {
  
      if (reportType.value === "custom") {
  
          customDateGroup.forEach(element => {
              element.classList.add("show");
          });
  
      } else {
  
          customDateGroup.forEach(element => {
              element.classList.remove("show");
          });
  
      }
  
  }
  
  reportType.addEventListener(
      "change",
      updateCustomDates
  );
  
  
  
  
  async function loadReport() {
  
      try {
  
          generateReportBtn.disabled = true;
  
          generateReportBtn.textContent =
              "Loading...";
  
  
          const params =
              new URLSearchParams();
  
  
          params.append(
              "type",
              reportType.value
          );
  
  
          
  
          if (reportType.value === "custom") {
  
              if (!fromDate.value || !toDate.value) {
  
                showAlert(
                    "Please select both dates.",
                    "danger"
                    );
  
                  return;
              }
  
  
              if (fromDate.value > toDate.value) {
                showAlert(
                    "From date cannot be after To date.",
                    "danger"
                    );
  
                  return;
              }
  
  
              params.append(
                  "from",
                  fromDate.value
              );
  
              params.append(
                  "to",
                  toDate.value
              );
  
          }
  
  
          const response =
              await fetch(
                  `/admin/reports/data?${params.toString()}`
              );
  
  
          const result =
              await response.json();
  
  
          if (!result.success) {
  
            showAlert(
            result.message ||
            "Unable to load report.",
            "danger"
            );
  
              return;
          }
  
  
          // ==========================
          // SUMMARY
          // ==========================
  
          const summary =
              result.data.summary;
  
  
          salesCount.textContent =
              summary.salesCount;
  
  
          grossSales.textContent =
              formatCurrency(
                  summary.grossSales
              );
  
  
          totalDiscount.textContent =
              formatCurrency(
                  summary.totalDiscount
              );
              totalRefund.textContent =
    formatCurrency(
        summary.totalRefund
    );
  
  
          netSales.textContent =
              formatCurrency(
                  summary.netSales
              );
  
  
          // ==========================
          // DATE RANGE
          // ==========================
  
          const start =
              result.data.dateRange.start;
  
          const end =
              result.data.dateRange.end;
  
  
          reportPeriod.textContent =
              `${formatDate(start)} - ${formatDate(end)}`;
  
  
          // ==========================
          // TABLE
          // ==========================
  
          renderOrders(
              result.data.orders
          );
  
  
      } catch (error) {
  
          console.error(
              "LOAD REPORT ERROR:",
              error
          );
  
          showAlert(
  "Something went wrong while loading the report.",
  "danger"
);
  
      } finally {
  
          generateReportBtn.disabled = false;
  
          generateReportBtn.textContent =
              "Generate Report";
  
      }
  
  }
  
  
  // ==============================
  // RENDER ORDERS
  // ==============================
  
  function renderOrders(orders) {

reportTableBody.innerHTML = "";

if (!orders || orders.length === 0) {

    const row = document.createElement("tr");

    const cell = document.createElement("td");
    cell.colSpan = 11;
    cell.className = "empty-report";
    cell.textContent = "No sales found for this period.";

    row.appendChild(cell);
    reportTableBody.appendChild(row);

    return;
}

orders.forEach((order, index) => {

    const customer =
        `${order.user?.firstName || ""} ${order.user?.lastName || ""}`
            .trim() || "Unknown";

    const row = document.createElement("tr");

    const values = [
        index + 1,
        order.orderId || "-",
        formatDate(order.createdAt),
        customer,
        formatCurrency(order.subtotal),
        formatCurrency(order.couponDiscount),
        formatCurrency(order.grandTotal),

formatCurrency(
    order.refundedAmount || 0
),

formatCurrency(
    Math.max(
        0,
        (order.grandTotal || 0) -
        (order.refundedAmount || 0)
    )
),

order.paymentMethod || "-",

order.status || "-"
    ];

    values.forEach(value => {

        const cell = document.createElement("td");

        // Safely insert text instead of HTML
        cell.textContent = String(value);

        row.appendChild(cell);
    });

    reportTableBody.appendChild(row);
});
}
  
  
  // ==============================
  // DOWNLOAD PARAMETERS
  // ==============================
  
  function getDownloadParams() {
  
      const params =
          new URLSearchParams();
  
  
      params.append(
          "type",
          reportType.value
      );
  
  
      if (reportType.value === "custom") {
  
          if (!fromDate.value || !toDate.value) {
  
            showAlert(
  "Please select both dates.",
  "danger"
);
  
              return null;
          }
  
  
          if (fromDate.value > toDate.value) {
  
            showAlert(
  "From date cannot be after To date.",
  "danger"
);
  
              return null;
          }
  
  
          params.append(
              "from",
              fromDate.value
          );
  
          params.append(
              "to",
              toDate.value
          );
  
      }
  
  
      return params;
  
  }
  
  
  // ==============================
  // PDF DOWNLOAD
  // ==============================
  
  downloadPdfBtn.addEventListener(
      "click",
      () => {
  
          const params =
              getDownloadParams();
  
  
          if (!params) {
              return;
          }
  
  
          window.location.href =
              `/admin/reports/download/pdf?${params.toString()}`;
  
      }
  );
  
  
  // ==============================
  // EXCEL DOWNLOAD
  // ==============================
  
  downloadExcelBtn.addEventListener(
      "click",
      () => {
  
          const params =
              getDownloadParams();
  
  
          if (!params) {
              return;
          }
  
  
          window.location.href =
              `/admin/reports/download/excel?${params.toString()}`;
  
      }
  );
  
  
  // ==============================
  // GENERATE REPORT
  // ==============================
  
  generateReportBtn.addEventListener(
      "click",
      loadReport
  );
  
  
  // ==============================
  // INITIAL PAGE LOAD
  // ==============================
  
  updateCustomDates();
  
  loadReport();
  
  </script>

</body>
</html>