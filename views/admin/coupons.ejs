<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Coupons & Offers | Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/coupons.css">
</head>

<body>
   <aside class="admin-sidebar">

    <div class="admin-logo">
        Alder & Ash.
    </div>

    <ul class="admin-menu">

        <li onclick="window.location.href='/admin'">
            Dashboard
        </li>

        <li onclick="window.location.href='/admin'">
            Users
        </li>

        <li onclick="window.location.href='/admin/products-page'">
            Products
        </li>

        <li onclick="window.location.href='/admin/brands-page'">
            Brands
        </li>

        <li onclick="window.location.href='/admin/category'">
            Category
        </li>

        <li onclick="window.location.href='/api/orders/admin/orders'">
            Orders
        </li>

        <li
            class="active"
            onclick="window.location.href='/admin/coupons-page'"
        >
            Coupons
        </li>

        <li>
            Banners
        </li>

        <li>
            Reports
        </li>

        <li>
            Settings
        </li>

    </ul>

</aside>
    <div class="coupon-page">

        <div class="coupon-header">

            <div>
                <h1>Coupons & Offers</h1>
                <p>Manage discount coupons and promotional offers</p>
            </div>

            <div class="header-actions">
                <button
                    class="add-coupon-btn secondary"
                    onclick="openOfferModal()">
                    + Add Offer
                </button>

                <button
                    class="add-coupon-btn"
                    onclick="openCouponModal()">
                    + Add Coupon
                </button>
            </div>

        </div>


        <div class="summary-grid">

            <div class="summary-card">
                <span>Total Coupons</span>
                <strong id="totalCoupons">0</strong>
            </div>

            <div class="summary-card">
                <span>Active Coupons</span>
                <strong id="activeCoupons">0</strong>
            </div>

            <div class="summary-card">
                <span>Total Offers</span>
                <strong id="totalOffers">0</strong>
            </div>

            <div class="summary-card">
                <span>Active Offers</span>
                <strong id="activeOffers">0</strong>
            </div>

        </div>


        <div class="coupon-card">

            <div class="coupon-card-header">

                <div>
                    <h2>Coupons & Offers</h2>
                    <p>View and manage all your promotions</p>
                </div>

                <div class="filter-buttons">

                    <button
                        class="filter-btn active"
                        onclick="filterPromotions('ALL', this)">
                        All
                    </button>

                    <button
                        class="filter-btn"
                        onclick="filterPromotions('COUPON', this)">
                        Coupons
                    </button>

                    <button
                        class="filter-btn"
                        onclick="filterPromotions('OFFER', this)">
                        Offers
                    </button>

                </div>

            </div>


            <div class="coupon-table-wrapper">

                <table class="coupon-table">

                    <thead>

                        <tr>
                            <th>Name / Code</th>
                            <th>Type</th>
                            <th>Discount</th>
                            <th>Target</th>
                            <th>Validity</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody id="promotionTableBody">

                        <tr>
                            <td colspan="7" class="empty-message">
                                Loading...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div class="modal-overlay" id="couponModal">

        <div class="coupon-modal">

            <div class="modal-header">

                <div>
                    <h2>Add Coupon</h2>
                    <p>Create a new discount coupon</p>
                </div>

                <button
                    type="button"
                    class="close-btn"
                    onclick="closeCouponModal()">
                    ×
                </button>

            </div>


            <form id="couponForm">

                <div class="form-group">

                    <label>Coupon Code</label>

                    <input
                        type="text"
                        id="code"
                        name="code"
                        placeholder="Example: SAVE10"
                        required>

                </div>


                <div class="form-group">

                    <label>Coupon Name</label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Summer Discount"
                        required>

                </div>


                <div class="form-group">

                    <label>Description</label>

                    <textarea
                        id="description"
                        name="description"
                        placeholder="Coupon description"></textarea>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label>Discount Type</label>

                        <select
                            id="discountType"
                            name="discountType"
                            required>

                            <option value="PERCENTAGE">
                                Percentage
                            </option>

                            <option value="FIXED">
                                Fixed Amount
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>Discount Value</label>

                        <input
                            type="number"
                            id="discountValue"
                            name="discountValue"
                            min="0"
                            required>

                    </div>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label>Minimum Order Amount</label>

                        <input
                            type="number"
                            id="minimumOrderAmount"
                            name="minimumOrderAmount"
                            min="0"
                            value="0">

                    </div>


                    <div class="form-group">

                        <label>Maximum Discount</label>

                        <input
                            type="number"
                            id="maximumDiscount"
                            name="maximumDiscount"
                            min="0">

                    </div>

                </div>


                <div class="form-group">

                    <label>Usage Limit</label>

                    <input
                        type="number"
                        id="usageLimit"
                        name="usageLimit"
                        min="1">

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label>Start Date</label>

                        <input
                            type="datetime-local"
                            id="startDate"
                            name="startDate"
                            required>

                    </div>


                    <div class="form-group">

                        <label>End Date</label>

                        <input
                            type="datetime-local"
                            id="endDate"
                            name="endDate"
                            required>

                    </div>

                </div>


                <div class="modal-actions">

                    <button
                        type="button"
                        class="cancel-btn"
                        onclick="closeCouponModal()">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="save-btn">
                        Create Coupon
                    </button>

                </div>

            </form>

        </div>

    </div>


    <div class="modal-overlay" id="offerModal">

        <div class="coupon-modal">

            <div class="modal-header">

                <div>
                    <h2>Add Offer</h2>
                    <p>Create a product or category offer</p>
                </div>

                <button
                    type="button"
                    class="close-btn"
                    onclick="closeOfferModal()">
                    ×
                </button>

            </div>


            <form id="offerForm">

                <div class="form-group">

                    <label>Offer Name</label>

                    <input
                        type="text"
                        id="offerName"
                        required
                        placeholder="Summer Product Offer">

                </div>


                <div class="form-group">

                    <label>Offer Type</label>

                    <select id="offerType">
                        <option value="CATEGORY">Category Offer</option>
                        <option value="PRODUCT">Product Offer</option>
                    </select>
                    
                    

                </div>


                <div
                    class="form-group"
                    id="productSelectGroup"
                    style="display:none;">

                    <label>Product</label>

                    <select id="offerProduct">

                        <option value="">
                            Select product
                        </option>

                    </select>

                </div>


                <div
                    class="form-group"
                    id="categorySelectGroup"
                    style="display:none;">

                    <label>Category</label>

                    <select id="offerCategory">

                        <option value="">
                            Select category
                        </option>

                    </select>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label>Discount Type</label>

                        <select
                            id="offerDiscountType"
                            required>

                            <option value="PERCENTAGE">
                                Percentage
                            </option>

                            <option value="FIXED">
                                Fixed Amount
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>Discount Value</label>

                        <input
                            type="number"
                            id="offerDiscountValue"
                            min="0"
                            required>

                    </div>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label>Start Date</label>

                        <input
                            type="datetime-local"
                            id="offerStartDate"
                            required>

                    </div>


                    <div class="form-group">

                        <label>End Date</label>

                        <input
                            type="datetime-local"
                            id="offerEndDate"
                            required>

                    </div>

                </div>


                <div class="modal-actions">

                    <button
                        type="button"
                        class="cancel-btn"
                        onclick="closeOfferModal()">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="save-btn">
                        Create Offer
                    </button>

                </div>

            </form>

        </div>

    </div>


    <script>

        const couponModal =
            document.getElementById("couponModal");

        const offerModal =
            document.getElementById("offerModal");

        const couponForm =
            document.getElementById("couponForm");

        const offerForm =
            document.getElementById("offerForm");

        const tableBody =
            document.getElementById("promotionTableBody");

        let promotions = [];

        let currentFilter = "ALL";


        function openCouponModal() {
            couponModal.classList.add("active");
        }


        function closeCouponModal() {
            couponModal.classList.remove("active");
            couponForm.reset();
        }


        function openOfferModal() {
            offerModal.classList.add("active");
        }


        function closeOfferModal() {
            offerModal.classList.remove("active");
            offerForm.reset();

            document.getElementById(
                "productSelectGroup"
            ).style.display = "none";

            document.getElementById(
                "categorySelectGroup"
            ).style.display = "none";
        }


        document.getElementById("offerType")
            .addEventListener("change", function () {

                const productGroup =
                    document.getElementById(
                        "productSelectGroup"
                    );

                const categoryGroup =
                    document.getElementById(
                        "categorySelectGroup"
                    );

                productGroup.style.display = "none";
                categoryGroup.style.display = "none";

                document.getElementById(
                    "offerProduct"
                ).required = false;

                document.getElementById(
                    "offerCategory"
                ).required = false;


                if (this.value === "PRODUCT") {

                    productGroup.style.display = "block";

                    document.getElementById(
                        "offerProduct"
                    ).required = true;

                }


                if (this.value === "CATEGORY") {

                    categoryGroup.style.display = "block";

                    document.getElementById(
                        "offerCategory"
                    ).required = true;

                }

            });


            async function loadProducts() {
    try {
        const response = await fetch("/admin/products");
        const result = await response.json();

        console.log("PRODUCT RESPONSE:", result);

        const select = document.getElementById("offerProduct");

        select.innerHTML = `
            <option value="">Select product</option>
        `;

        const products =
            result.products ||
            result.data ||
            [];

        products.forEach(product => {
            select.innerHTML += `
                <option value="${product._id}">
                    ${product.productName}
                </option>
            `;
        });

    } catch (error) {
        console.error("LOAD PRODUCTS ERROR:", error);
    }
}


async function loadCategories() {
    try {
        const response = await fetch("/admin/categories");
        const result = await response.json();

        console.log("CATEGORY RESPONSE:", result);

        const select = document.getElementById("offerCategory");

        select.innerHTML = `
            <option value="">Select category</option>
        `;

        const categories =
            result.categories ||
            result.data ||
            [];

        categories.forEach(category => {
            select.innerHTML += `
                <option value="${category._id}">
                    ${category.name}
                </option>
            `;
        });

    } catch (error) {
        console.error("LOAD CATEGORIES ERROR:", error);
    }
}


        async function loadPromotions() {

            try {

                const [
                    couponResponse,
                    offerResponse
                ] = await Promise.all([

                    fetch("/admin/coupons"),

                    fetch("/admin/offers")

                ]);


                const couponResult =
                    await couponResponse.json();

                const offerResult =
                    await offerResponse.json();


                const coupons =
                    couponResult.success
                        ? couponResult.coupons
                        : [];


                const offers =
                    offerResult.success
                        ? offerResult.offers
                        : [];


                promotions = [

                    ...coupons.map(coupon => ({
                        ...coupon,
                        promotionType: "COUPON"
                    })),

                    ...offers.map(offer => ({
                        ...offer,
                        promotionType: "OFFER"
                    }))

                ];


                updateSummary();

                renderPromotions();

            } catch (error) {

                console.error(
                    "LOAD PROMOTIONS ERROR:",
                    error
                );

                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="empty-message">
                            Unable to load promotions
                        </td>
                    </tr>
                `;

            }

        }


        function updateSummary() {

            const coupons =
                promotions.filter(
                    item =>
                        item.promotionType === "COUPON"
                );


            const offers =
                promotions.filter(
                    item =>
                        item.promotionType === "OFFER"
                );


            document.getElementById(
                "totalCoupons"
            ).textContent =
                coupons.length;


            document.getElementById(
                "activeCoupons"
            ).textContent =
                coupons.filter(
                    coupon =>
                        coupon.status === "ACTIVE"
                ).length;


            document.getElementById(
                "totalOffers"
            ).textContent =
                offers.length;


            document.getElementById(
                "activeOffers"
            ).textContent =
                offers.filter(
                    offer =>
                        offer.isActive === true
                ).length;

        }


        function renderPromotions() {

            let filtered =
                promotions;


            if (currentFilter !== "ALL") {

                filtered =
                    promotions.filter(
                        item =>
                            item.promotionType ===
                            currentFilter
                    );

            }


            tableBody.innerHTML = "";


            if (filtered.length === 0) {

                tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="empty-message">
                            No promotions found
                        </td>
                    </tr>
                `;

                return;

            }


            filtered.forEach(item => {

                const isCoupon =
                    item.promotionType === "COUPON";


                const discount =
                    item.discountType === "PERCENTAGE"
                        ? `${item.discountValue}%`
                        : `₹${item.discountValue}`;


                const startDate =
                    new Date(
                        item.startDate
                    ).toLocaleDateString();


                const endDate =
                    new Date(
                        item.endDate
                    ).toLocaleDateString();


                let target = "-";


                if (isCoupon) {

                    target = "All Orders";

                } else if (item.product) {

                    target =
                        `Product: ${
                            item.product.productName
                        }`;

                } else if (item.category) {

                    target =
                        `Category: ${
                            item.category.name
                        }`;

                }


                const status =
                    isCoupon
                        ? item.status
                        : item.isActive
                            ? "ACTIVE"
                            : "INACTIVE";


                tableBody.innerHTML += `

                    <tr>

                        <td>

                            <strong>
                                ${
                                    isCoupon
                                        ? item.code
                                        : item.name
                                }
                            </strong>

                            ${
                                isCoupon
                                    ? `<small>${item.name}</small>`
                                    : ""
                            }

                        </td>


                        <td>

                            <span class="type-badge ${
                                isCoupon
                                    ? "coupon-type"
                                    : "offer-type"
                            }">

                                ${
                                    isCoupon
                                        ? "COUPON"
                                        : "OFFER"
                                }

                            </span>

                        </td>


                        <td>

                            <strong>
                                ${discount}
                            </strong>

                        </td>


                        <td>
                            ${target}
                        </td>


                        <td>

                            ${startDate}
                            -
                            ${endDate}

                        </td>


                        <td>

                            <span class="status-badge ${
                                status === "ACTIVE"
                                    ? "active-status"
                                    : "inactive-status"
                            }">

                                ${status}

                            </span>

                        </td>


                        <td>

                            ${
                                isCoupon

                                    ? `
                                        <button
                                            class="delete-btn"
                                            onclick="deleteCoupon('${item._id}')">
                                            Delete
                                        </button>
                                    `

                                    : `
                                        <div class="action-buttons">

                                            <button
                                                class="status-btn"
                                                onclick="toggleOffer('${item._id}')">
                                                ${
                                                    item.isActive
                                                        ? "Disable"
                                                        : "Enable"
                                                }
                                            </button>

                                            <button
                                                class="delete-btn"
                                                onclick="deleteOffer('${item._id}')">
                                                Delete
                                            </button>

                                        </div>
                                    `
                            }

                        </td>

                    </tr>

                `;

            });

        }


        function filterPromotions(
            filter,
            button
        ) {

            currentFilter =
                filter;


            document
                .querySelectorAll(
                    ".filter-btn"
                )
                .forEach(btn =>
                    btn.classList.remove("active")
                );


            button.classList.add("active");

            renderPromotions();

        }


        couponForm.addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();


                const formData =
                    new FormData(couponForm);


                const couponData = {

                    code:
                        formData.get("code"),

                    name:
                        formData.get("name"),

                    description:
                        formData.get("description"),

                    discountType:
                        formData.get("discountType"),

                    discountValue:
                        formData.get("discountValue"),

                    minimumOrderAmount:
                        formData.get(
                            "minimumOrderAmount"
                        ),

                    maximumDiscount:
                        formData.get(
                            "maximumDiscount"
                        ),

                    usageLimit:
                        formData.get(
                            "usageLimit"
                        ),

                    startDate:
                        formData.get("startDate"),

                    endDate:
                        formData.get("endDate")

                };


                try {

                    const response =
                        await fetch(
                            "/admin/coupons",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify(
                                        couponData
                                    )
                            }
                        );


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message
                        );

                    }


                    alert(
                        "Coupon created successfully"
                    );


                    closeCouponModal();

                    loadPromotions();


                } catch (error) {

                    alert(error.message);

                }

            }
        );


        offerForm.addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();


                const type =
                    document.getElementById(
                        "offerType"
                    ).value;


                const offerData = {

                    name:
                        document.getElementById(
                            "offerName"
                        ).value,

                    discountType:
                        document.getElementById(
                            "offerDiscountType"
                        ).value,

                    discountValue:
                        document.getElementById(
                            "offerDiscountValue"
                        ).value,

                    startDate:
                        document.getElementById(
                            "offerStartDate"
                        ).value,

                    endDate:
                        document.getElementById(
                            "offerEndDate"
                        ).value,

                    productId:
                        type === "PRODUCT"
                            ? document.getElementById(
                                "offerProduct"
                            ).value
                            : null,

                    categoryId:
                        type === "CATEGORY"
                            ? document.getElementById(
                                "offerCategory"
                            ).value
                            : null

                };


                try {

                    const response =
                        await fetch(
                            "/admin/offers",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify(
                                        offerData
                                    )
                            }
                        );


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message
                        );

                    }


                    alert(
                        "Offer created successfully"
                    );


                    closeOfferModal();

                    loadPromotions();


                } catch (error) {

                    alert(error.message);

                }

            }
        );


        async function deleteCoupon(
            couponId
        ) {

            if (
                !confirm(
                    "Are you sure you want to delete this coupon?"
                )
            ) {
                return;
            }


            try {

                const response =
                    await fetch(
                        `/admin/coupons/${couponId}`,
                        {
                            method: "DELETE"
                        }
                    );


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message
                    );

                }


                loadPromotions();


            } catch (error) {

                alert(error.message);

            }

        }


        async function deleteOffer(
            offerId
        ) {

            if (
                !confirm(
                    "Are you sure you want to delete this offer?"
                )
            ) {
                return;
            }


            try {

                const response =
                    await fetch(
                        `/admin/offers/${offerId}`,
                        {
                            method: "DELETE"
                        }
                    );


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message
                    );

                }


                loadPromotions();


            } catch (error) {

                alert(error.message);

            }

        }


        async function toggleOffer(
            offerId
        ) {

            try {

                const response =
                    await fetch(
                        `/admin/offers/${offerId}/status`,
                        {
                            method: "PATCH"
                        }
                    );


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message
                    );

                }


                loadPromotions();


            } catch (error) {

                alert(error.message);

            }

        }


        loadProducts();
        loadCategories();
        loadPromotions();

    </script>

</body>

</html>