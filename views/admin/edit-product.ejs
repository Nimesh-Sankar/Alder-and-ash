<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Edit Product</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />

</head>

<body>

  <div class="admin-container">

  
   <!-- SIDEBAR -->

<!-- PRODUCTS SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li
      onclick="window.location.href='/admin'"
    >
      Dashboard
    </li>

    <li
      onclick="window.location.href='/admin'"
    >
      Users
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li>
      Orders
    </li>

    <li>
      Coupons
    </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>
 
    <!-- MAIN -->
    <main class="admin-main">

      <div class="form-container">

        <h1>Edit Product</h1>

        <form id="editProductForm">

          <input
            type="text"
            id="productName"
            placeholder="Product Name"
            required
          />

          <textarea
            id="productDescription"
            placeholder="Description"
            required
          ></textarea>

          <select
            id="productCategory"
            required
          >
            <option value="">
              Select Category
            </option>
          </select>

          <select
            id="productBrand"
            required
          >
            <option value="">
              Select Brand
            </option>
          </select>

          <div class="variant-section">

            <h3>
              Product Variants
            </h3>
          
            <div class="variant-inputs">
          
              <input
                type="text"
                id="variantSize"
                placeholder="Size"
              />
          
              <input
                type="text"
                id="variantColor"
                placeholder="Color"
              />
          
              <input
                type="number"
                id="variantPrice"
                placeholder="Price"
              />
          
              <input
                type="number"
                id="variantStock"
                placeholder="Stock"
              />
          
              <button
                type="button"
                onclick="addVariant()"
              >
                Add Variant
              </button>
          
            </div>
          
            <div id="variantList">
          
            </div>
          
          </div>
          <div class="form-group">

            <label>
              Product Images
            </label>
          
            <input
              type="file"
              id="productImages"
              multiple
              accept="image/*"
            />
          
          </div>
          
          <h3>Current Images</h3>
          
          <div
            id="existingImages"
            class="image-preview-container"
          >
          
          </div>
          <button type="submit">
            Update Product
          </button>

        </form>

      </div>

    </main>

  </div>
 
  <script src="/js/admin.js"></script>

</body>
</html>