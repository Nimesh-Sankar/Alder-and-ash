<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Edit Product</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />
 
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
 </head>
 <link
 rel="stylesheet"
 href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css"
 />

<body>
  <div id="alertBox"
    class="alert d-none position-fixed top-0 start-50 translate-middle-x mt-3"
    role="alert"
    style="z-index: 9999;">
  </div>

  <div class="admin-container">

  
   <!-- SIDEBAR -->

<!-- PRODUCTS SIDEBAR -->

<aside class="admin-sidebar">

  <h2 class="admin-logo">
    Alder & Ash.
  </h2>

  <ul class="admin-menu">

    <li
      onclick="window.location.href='/admin'"
    >
      Dashboard
    </li>

    <li
      onclick="window.location.href='/admin'"
    >
      Users
    </li>

    <li
      class="active"
      onclick="window.location.href='/admin/products-page'"
    >
      Products
    </li>

    <li
      onclick="window.location.href='/admin/brands-page'"
    >
      Brands
    </li>

    <li
      onclick="window.location.href='/admin/category'"
    >
      Category
    </li>

    <li onclick="window.location.href='/api/orders/admin/orders'">
      Orders
    </li>

    <li>
      Coupons
    </li>

    <li>
      Banners
    </li>

    <li>
      Reports
    </li>

    <li>
      Settings
    </li>

  </ul>

</aside>
 
    <!-- MAIN -->
    <main class="admin-main">

      <div class="form-container">

        <h1>Edit Product</h1>

        <form id="editProductForm">

          <input
            type="text"
            id="productName"
            placeholder="Product Name"
            
          />

          <textarea
            id="productDescription"
            placeholder="Description"
            
          ></textarea>

          <select
            id="productCategory"
            
          >
            <option value="">
              Select Category
            </option>
          </select>

          <select
            id="productBrand"
            
          >
            <option value="">
              Select Brand
            </option>
          </select>

          <div class="variant-section">

            <h3>
              Product Variants
            </h3>
          
            <div class="variant-inputs">
          
              <input
                type="text"
                id="variantSize"
                placeholder="Size"
              />
          
              <input
                type="text"
                id="variantColor"
                placeholder="Color"
              />
          
              <input
                type="number"
                id="variantPrice"
                placeholder="Price"
                min="1"
                step="1"
              />
          
              <input
                type="number"
                id="variantStock"
                placeholder="Stock"
                min="0"
                step="1"
              />
          
              <button
                type="button"
                onclick="addVariant()"
              >
                Add Variant
              </button>
          
            </div>
          
            <div id="variantList">
          
            </div>
          
          </div>
          <div class="form-group">

            <label>
              Product Images
            </label>
          
            <input
    type="file"
    id="productImages"
    accept=".jpg,.jpeg,.png,.webp"
/>

<div id="cropContainer">
    <img
        id="imagePreview"
        style="max-width:300px; display:none;"
    >
</div>

<button
    type="button"
    onclick="saveCroppedImage()">
    Save Cropped Image
</button>

<div id="croppedImagesList"></div>
          
          </div>
          
          <h3>Current Images</h3>
          
          <div
            id="existingImages"
            class="image-preview-container"
          >
          
          </div>
          <button type="submit">
            Update Product
          </button>

        </form>

      </div>

    </main>

  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
  <script src="/js/admin.js"></script>

</body>
</html>